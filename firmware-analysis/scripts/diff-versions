#!/usr/bin/env bash
# Summarise what changed between two unpacked BIOS versions.
#
# Usage: diff-versions work/v0.19 work/v0.21
set -euo pipefail

a=$(realpath "$1")
b=$(realpath "$2")

# Print only the changed lines of a diff, or "none".
changes() {
    local out
    out=$(diff "$1" "$2" | grep '^[<>]' || true)
    echo "${out:-   none}"
}

# CRC32 differs for almost every module between builds (embedded timestamps),
# so compare sizes: a size change means the code or data really changed.
echo "== FFS modules whose size changed (name, GUID, subtype, size)"
changes <(cut -f1-4 "$a/modules.tsv" | sort -u) <(cut -f1-4 "$b/modules.tsv" | sort -u)

echo
echo "== PSP entries changed (type, version, size, md5)"
changes "$a/psp-entries.tsv" "$b/psp-entries.tsv"

echo
echo "== ACPI tables changed"
for f in "$b"/acpi/*.dsl "$a"/acpi/*.dsl; do basename "$f"; done | sort -u | while read -r t; do
    if [[ ! -f $a/acpi/$t ]]; then echo "   added:   $t"
    elif [[ ! -f $b/acpi/$t ]]; then echo "   removed: $t"
    elif ! diff -q <(grep -v '^ \*' "$a/acpi/$t") <(grep -v '^ \*' "$b/acpi/$t") >/dev/null; then
        echo "   changed: $t  (diff -u $a/acpi/$t $b/acpi/$t)"
    fi
done
