diff --git a/data/ionwl/way_shell_ionwl.py b/data/ionwl/way_shell_ionwl.py
new file mode 100644
index 0000000..c17ed2a
--- /dev/null
+++ b/data/ionwl/way_shell_ionwl.py
@@ -0,0 +1,205 @@
+# Way-Shell helper, loaded into the IonWL compositor's Python interpreter over
+# its IPC socket. Way-Shell queries state and runs actions through it, and the
+# hooks it attaches tell Way-Shell when desktops change.
+#
+# An IonWL desktop spans every output, so each one is reported as a single
+# Way-Shell workspace placed on the focused output.
+
+import json
+import os
+import socket
+
+import ion
+
+# Hooks after which the reported state may differ.
+HOOKS = (
+    'desktop_new_post',
+    'desktop_remove_post',
+    'desktop_rename_post',
+    'desktop_switch_post',
+    'window_new_post',
+    'window_close_post',
+    'window_move_post',
+    'window_focus_post',
+    'window_urgent_post',
+    'output_add_post',
+    'output_remove_post',
+    'compositor_reload_post',
+)
+
+_event_path = None
+_event_sock = None
+
+
+def _notify(*_args, **_kwargs):
+    if _event_sock is None:
+        return
+    try:
+        _event_sock.sendto(b'\n', _event_path)
+    except (BlockingIOError, InterruptedError):
+        # Way-Shell is behind: it refreshes from the pings already queued.
+        pass
+    except OSError:
+        # Way-Shell is gone.
+        hooks_remove()
+
+
+def hooks_installed():
+    return _notify in ion.app.hooks.desktop_switch_post
+
+
+def hooks_install(name):
+    '''Ping the abstract datagram socket *name* on every change.
+
+    Returns True when the hooks had to be (re-)attached, as after a config
+    reload, which detaches every hook.
+    '''
+    global _event_path, _event_sock
+    path = '\0' + name
+    if path != _event_path or _event_sock is None:
+        if _event_sock is not None:
+            _event_sock.close()
+        _event_sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
+        _event_sock.setblocking(False)
+        _event_path = path
+    attached = False
+    for name in HOOKS:
+        hook = getattr(ion.app.hooks, name)
+        if _notify not in hook:
+            hook.append(_notify)
+            attached = True
+    return attached
+
+
+def hooks_remove():
+    global _event_path, _event_sock
+    for name in HOOKS:
+        hook = getattr(ion.app.hooks, name)
+        if _notify in hook:
+            hook.remove(_notify)
+    if _event_sock is not None:
+        _event_sock.close()
+    _event_path = None
+    _event_sock = None
+
+
+def _output_focused():
+    output = ion.wm.context.output
+    if output is not None:
+        return output
+    for output in ion.wm.outputs:
+        if output.is_enabled:
+            return output
+    return None
+
+
+def _desktop_find(desktop_id, name):
+    desktops = ion.wm.desktops
+    if desktop_id >= 0:
+        for desktop in desktops:
+            if desktop.id == desktop_id:
+                return desktop
+    for desktop in desktops:
+        if desktop.name == name:
+            return desktop
+    return None
+
+
+def _desktop_ensure(desktop_id, name):
+    desktop = _desktop_find(desktop_id, name)
+    if desktop is None and name:
+        desktop = ion.wm.desktops.new(name)
+    return desktop
+
+
+def _window_focused():
+    window = ion.wm.context.window
+    if window is not None:
+        return window
+    for window in ion.wm.windows:
+        if window.is_focused:
+            return window
+    return None
+
+
+def state():
+    desktops = ion.wm.desktops
+    active = desktops.active
+    output = _output_focused()
+    output_name = output.name if output is not None else ''
+
+    urgent = set()
+    for window in ion.wm.windows:
+        if window.urgent:
+            desktop = desktops.find_by_window(window)
+            if desktop is not None:
+                urgent.add(desktop.id)
+
+    workspaces = [
+        {
+            'id': desktop.id,
+            'num': index + 1,
+            'name': desktop.name,
+            'output': output_name,
+            'focused': desktop == active,
+            'visible': desktop == active,
+            'urgent': desktop.id in urgent,
+            'empty': desktop.is_empty,
+        }
+        for index, desktop in enumerate(desktops)
+    ]
+    outputs = [
+        {
+            'name': o.name,
+            'current_workspace': active.name if o.is_enabled else '',
+        }
+        for o in ion.wm.outputs
+    ]
+    return json.dumps({'workspaces': workspaces, 'outputs': outputs})
+
+
+def focus(desktop_id, name):
+    desktop = _desktop_ensure(desktop_id, name)
+    if desktop is None:
+        return False
+    desktop.focus()
+    return True
+
+
+def rename(name):
+    if not name:
+        return False
+    ion.wm.desktops.active.name = name
+    return True
+
+
+def window_to(desktop_id, name):
+    window = _window_focused()
+    desktop = _desktop_ensure(desktop_id, name)
+    if window is None or desktop is None:
+        return False
+    if desktop == ion.wm.desktops.find_by_window(window):
+        return True
+    items = list(desktop.items_tiling)
+    if not items:
+        return False
+    # Keep the window on its output when the desktop has a workspace there.
+    target = items[0].workspace
+    source = window.workspace
+    if source is not None:
+        for item in ion.wm.desktops.find_by_window(window).items_tiling:
+            if item.workspace == source and item.output is not None:
+                for other in items:
+                    if other.output == item.output:
+                        target = other.workspace
+                break
+    window.move_to_workspace(target)
+    return True
+
+
+def output_focus(name):
+    for output in ion.wm.outputs:
+        if output.name == name:
+            output.focus()
+            return True
+    return False
