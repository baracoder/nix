+/// Roundtrip and return the gesture events the client received since the
+/// last call.
+fn gesture_events_take(fixture: &mut Fixture, client_id: ClientId) -> Vec<PointerGestureEvent> {
+    fixture.roundtrip(client_id);
+    fixture.client(client_id).pointer_gesture_events_take()
+}
+
+/// A swipe reaches the client holding pointer focus, begin to end.
+#[test]
+fn gesture_swipe_to_client() {
+    let (mut fixture, client_id) = gesture_client_fixture();
+    fixture.ionwl().gesture_swipe_begin_simulate(3);
+    fixture.ionwl().gesture_swipe_update_simulate(5.0, -2.5);
+    fixture.ionwl().gesture_swipe_update_simulate(1.0, 0.0);
+    fixture.ionwl().gesture_swipe_end_simulate(false);
+    assert_eq!(
+        gesture_events_take(&mut fixture, client_id),
+        [
+            PointerGestureEvent::SwipeBegin { fingers: 3 },
+            PointerGestureEvent::SwipeUpdate(5.0, -2.5),
+            PointerGestureEvent::SwipeUpdate(1.0, 0.0),
+            PointerGestureEvent::SwipeEnd { cancelled: false },
+        ],
+    );
+}
+
+/// A pinch carries its scale and rotation through to the client.
+#[test]
+fn gesture_pinch_to_client() {
+    let (mut fixture, client_id) = gesture_client_fixture();
+    fixture.ionwl().gesture_pinch_begin_simulate(2);
+    fixture
+        .ionwl()
+        .gesture_pinch_update_simulate(1.0, 2.0, 1.5, 10.0);
+    fixture
+        .ionwl()
+        .gesture_pinch_update_simulate(0.0, 0.0, 0.75, -4.0);
+    fixture.ionwl().gesture_pinch_end_simulate(false);
+    assert_eq!(
+        gesture_events_take(&mut fixture, client_id),
+        [
+            PointerGestureEvent::PinchBegin { fingers: 2 },
+            PointerGestureEvent::PinchUpdate(1.0, 2.0, 1.5, 10.0),
+            PointerGestureEvent::PinchUpdate(0.0, 0.0, 0.75, -4.0),
+            PointerGestureEvent::PinchEnd { cancelled: false },
+        ],
+    );
+}
+
+/// A gesture libinput cancels ends cancelled in the client too, so it can
+/// undo what the gesture did.
+#[test]
+fn gesture_cancelled_end_to_client() {
+    let (mut fixture, client_id) = gesture_client_fixture();
+    fixture.ionwl().gesture_hold_begin_simulate(2);
+    fixture.ionwl().gesture_hold_end_simulate(true);
+    fixture.ionwl().gesture_swipe_begin_simulate(4);
+    fixture.ionwl().gesture_swipe_end_simulate(true);
+    assert_eq!(
+        gesture_events_take(&mut fixture, client_id),
+        [
+            PointerGestureEvent::HoldBegin { fingers: 2 },
+            PointerGestureEvent::HoldEnd { cancelled: true },
+            PointerGestureEvent::SwipeBegin { fingers: 4 },
+            PointerGestureEvent::SwipeEnd { cancelled: true },
+        ],
+    );
+}
+
+/// Gestures go to the pointer focus only: a client listening for them
+/// without a surface under the pointer sees none.
+#[test]
+fn gesture_only_to_pointer_focus() {
+    let (mut fixture, client_id) = gesture_client_fixture();
+    let other = fixture.add_client();
+    fixture.roundtrip(other);
+    fixture.client(other).pointer_gestures_get();
+    fixture.roundtrip(other);
+
+    fixture.ionwl().gesture_swipe_begin_simulate(3);
+    fixture.ionwl().gesture_swipe_end_simulate(false);
+
+    assert_eq!(gesture_events_take(&mut fixture, other), []);
+    assert_eq!(gesture_events_take(&mut fixture, client_id).len(), 2);
+}
+
+/// A consuming generator owns the pointer, so a gesture neither begins nor
+/// moves in the client meanwhile.
+#[test]
+fn gesture_withheld_from_client_while_generator_consumes() {
+    let (mut fixture, client_id) = gesture_client_fixture();
+    generator_record_start(&mut fixture, 1);
+    fixture.ionwl().gesture_swipe_begin_simulate(3);
+    fixture.ionwl().gesture_swipe_update_simulate(5.0, 0.0);
+    fixture.ionwl().gesture_swipe_end_simulate(false);
+    assert_eq!(gesture_events_take(&mut fixture, client_id), []);
+}
+
+/// Locking the session cancels a gesture in progress on a window behind
+/// the lock, and nothing further reaches that window while locked.
+#[test]
+fn gesture_not_to_client_while_locked() {
+    let (mut fixture, client_id) = gesture_client_fixture();
+    fixture.ionwl().gesture_swipe_begin_simulate(3);
+    assert_eq!(
+        gesture_events_take(&mut fixture, client_id),
+        [PointerGestureEvent::SwipeBegin { fingers: 3 }],
+    );
+
+    let _locker = fixture.session_lock_and_confirm();
+    fixture.ionwl().gesture_swipe_update_simulate(5.0, 0.0);
+    fixture.ionwl().gesture_swipe_end_simulate(false);
+    fixture.pointer_simulate_motion([110, 110]);
+    fixture.ionwl().pointer_focus_update_test();
+    fixture.ionwl().gesture_pinch_begin_simulate(2);
+    fixture
+        .ionwl()
+        .gesture_pinch_update_simulate(0.0, 0.0, 2.0, 0.0);
+    fixture.ionwl().gesture_pinch_end_simulate(false);
+
+    assert_eq!(
+        gesture_events_take(&mut fixture, client_id),
+        [PointerGestureEvent::SwipeEnd { cancelled: true }],
+        "the lock cancels the swipe, and the window sees nothing after it"
+    );
+}
