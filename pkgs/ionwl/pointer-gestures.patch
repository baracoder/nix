+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Touchpad gestures: swipe, pinch and hold, forwarded through
+//! `pointer-gestures` to the client holding pointer focus.
+//!
+//! Gestures go where scroll goes, to the pointer focus, so the locked
+//! hit-test confining that focus to the lock surface keeps them from the
+//! windows behind it. Smithay tracks which surface each client's gesture
+//! began on and cancels it when that surface loses pointer focus, so a
+//! gesture cut short by a lock, or by the pointer focus moving, ends there
+//! rather than running on in the client.
+
+use smithay::backend::input::{
+    GestureBeginEvent, GestureEndEvent, GesturePinchUpdateEvent, GestureSwipeUpdateEvent,
+    InputBackend,
+};
+use smithay::input::pointer::{
+    GestureHoldBeginEvent, GestureHoldEndEvent, GesturePinchBeginEvent, GesturePinchEndEvent,
+    GesturePinchUpdateEvent as PinchUpdate, GestureSwipeBeginEvent, GestureSwipeEndEvent,
+    GestureSwipeUpdateEvent as SwipeUpdate,
+};
+use smithay::utils::SERIAL_COUNTER;
+
+use super::device_ptr_extract;
+use crate::state::IonMain;
+
+/// Which gesture a begin or end event belongs to. Their payloads are the
+/// same for all three, so one handler each serves every kind.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum GestureKind {
+    Swipe,
+    Pinch,
+    Hold,
+}
+
+impl IonMain {
+    /// Handle a gesture beginning: forward it to the pointer focus.
+    pub(super) fn handle_gesture_begin<I: InputBackend>(
+        &mut self,
+        kind: GestureKind,
+        event: &impl GestureBeginEvent<I>,
+    ) {
+        self.pointer_active_update(device_ptr_extract(&event.device()));
+
+        // Gesture activity invalidates a pending key click, as scrolling does.
+        self.wm.event_state.pending_key_click_invalidate();
+
+        let Some(pointer) = self.wm.seat.get_pointer() else {
+            return;
+        };
+        let serial = SERIAL_COUNTER.next_serial();
+        let time = event.time();
+        let fingers = event.fingers();
+        match kind {
+            GestureKind::Swipe => pointer.gesture_swipe_begin(
+                self,
+                &GestureSwipeBeginEvent {
+                    serial,
+                    time,
+                    fingers,
+                },
+            ),
+            GestureKind::Pinch => pointer.gesture_pinch_begin(
+                self,
+                &GesturePinchBeginEvent {
+                    serial,
+                    time,
+                    fingers,
+                },
+            ),
+            GestureKind::Hold => pointer.gesture_hold_begin(
+                self,
+                &GestureHoldBeginEvent {
+                    serial,
+                    time,
+                    fingers,
+                },
+            ),
+        }
+    }
+
+    /// Handle a swipe moving: forward its delta to the pointer focus.
+    pub(super) fn handle_gesture_swipe_update<I: InputBackend>(
+        &mut self,
+        event: &impl GestureSwipeUpdateEvent<I>,
+    ) {
+        if let Some(pointer) = self.wm.seat.get_pointer() {
+            pointer.gesture_swipe_update(
+                self,
+                &SwipeUpdate {
+                    time: event.time(),
+                    delta: event.delta(),
+                },
+            );
+        }
+    }
+
+    /// Handle a pinch changing: forward its delta, scale and rotation to the
+    /// pointer focus.
+    pub(super) fn handle_gesture_pinch_update<I: InputBackend>(
+        &mut self,
+        event: &impl GesturePinchUpdateEvent<I>,
+    ) {
+        if let Some(pointer) = self.wm.seat.get_pointer() {
+            pointer.gesture_pinch_update(
+                self,
+                &PinchUpdate {
+                    time: event.time(),
+                    delta: event.delta(),
+                    scale: event.scale(),
+                    rotation: event.rotation(),
+                },
+            );
+        }
+    }
+
+    /// Handle a gesture ending, completed or cancelled.
+    ///
+    /// Smithay sends the end only to a client whose gesture began, so this is
+    /// safe to call for one that never reached a client.
+    pub(super) fn gesture_end_forward<I: InputBackend>(
+        &mut self,
+        kind: GestureKind,
+        event: &impl GestureEndEvent<I>,
+    ) {
+        let Some(pointer) = self.wm.seat.get_pointer() else {
+            return;
+        };
+        let serial = SERIAL_COUNTER.next_serial();
+        let time = event.time();
+        let cancelled = event.cancelled();
+        match kind {
+            GestureKind::Swipe => pointer.gesture_swipe_end(
+                self,
+                &GestureSwipeEndEvent {
+                    serial,
+                    time,
+                    cancelled,
+                },
+            ),
+            GestureKind::Pinch => pointer.gesture_pinch_end(
+                self,
+                &GesturePinchEndEvent {
+                    serial,
+                    time,
+                    cancelled,
+                },
+            ),
+            GestureKind::Hold => pointer.gesture_hold_end(
+                self,
+                &GestureHoldEndEvent {
+                    serial,
+                    time,
+                    cancelled,
+                },
+            ),
+        }
+    }
+}
