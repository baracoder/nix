+
+/// `scroll_client_fixture` with the dispatch test operators registered and
+/// `button` (a `pointer_buttons` name) bound in the global keymap to `op`.
+fn wheel_binding_fixture(button: &str, event_action: EventAction, op: &str) -> (Fixture, ClientId) {
+    let (mut fixture, client_id) = scroll_client_fixture();
+    fixture
+        .python_call("keybinding_dispatch", "setup", ())
+        .expect("the test operators should register");
+    fixture
+        .python_call(
+            "keybinding_dispatch",
+            "pointer_binding_add",
+            (
+                "global",
+                button,
+                event_action as i32,
+                false,
+                true,
+                false,
+                Some(op),
+            ),
+        )
+        .expect("the wheel binding should register");
+    (fixture, client_id)
+}
+
+/// A wheel detent runs its virtual button's Press binding, and the client
+/// does not scroll by it as well.
+#[test]
+fn wheel_binding_takes_the_detent() {
+    let (mut fixture, client_id) =
+        wheel_binding_fixture("WHEEL_DOWN", EventAction::PRESS, "test_noop_a");
+    let events = scroll_to_client(
+        &mut fixture,
+        client_id,
+        AxisSource::Wheel,
+        Axis::Vertical,
+        Some(15.0),
+        Some(120.0),
+        AxisRelativeDirection::Identical,
+    );
+    assert_eq!(fixture.operator_log_take(), ["test_noop_a"]);
+    assert_eq!(events, []);
+}
+
+/// A detent has no release to wait for, so a Click binding - `MatchPointer`'s
+/// default action - runs on it too.
+#[test]
+fn wheel_binding_click_runs_on_the_detent() {
+    let (mut fixture, client_id) =
+        wheel_binding_fixture("WHEEL_UP", EventAction::CLICK, "test_noop_a");
+    scroll_to_client(
+        &mut fixture,
+        client_id,
+        AxisSource::Wheel,
+        Axis::Vertical,
+        Some(-15.0),
+        Some(-120.0),
+        AxisRelativeDirection::Identical,
+    );
+    assert_eq!(fixture.operator_log_take(), ["test_noop_a"]);
+}
+
+/// A high-resolution wheel's fractions of a detent add up to one binding run,
+/// and none of them scroll the client in the meantime.
+#[test]
+fn wheel_binding_accumulates_partial_detents() {
+    let (mut fixture, client_id) =
+        wheel_binding_fixture("WHEEL_DOWN", EventAction::PRESS, "test_noop_a");
+    let mut events = Vec::new();
+    for _ in 0..3 {
+        events.extend(scroll_to_client(
+            &mut fixture,
+            client_id,
+            AxisSource::Wheel,
+            Axis::Vertical,
+            Some(5.0),
+            Some(40.0),
+            AxisRelativeDirection::Identical,
+        ));
+        if fixture.operator_log_take().is_empty() {
+            continue;
+        }
+        assert!(events.is_empty(), "the client saw none of the detent");
+        return;
+    }
+    panic!("three thirds of a detent ran no binding");
+}
+
+/// Only the bound direction is taken: scrolling the other way reaches the
+/// client as before.
+#[test]
+fn wheel_binding_leaves_the_other_direction() {
+    let (mut fixture, client_id) =
+        wheel_binding_fixture("WHEEL_DOWN", EventAction::PRESS, "test_noop_a");
+    let events = scroll_to_client(
+        &mut fixture,
+        client_id,
+        AxisSource::Wheel,
+        Axis::Vertical,
+        Some(-15.0),
+        Some(-120.0),
+        AxisRelativeDirection::Identical,
+    );
+    assert_eq!(fixture.operator_log_take(), Vec::<String>::new());
+    assert!(
+        events.contains(&PointerAxisEvent::Value120(
+            wl_pointer::Axis::VerticalScroll,
+            -120
+        )),
+        "the client scrolled: {events:?}"
+    );
+}
+
+/// A binding whose operator passes through has run nothing, so the detent
+/// still scrolls the client, as an unbound one would.
+#[test]
+fn wheel_binding_passing_operator_forwards() {
+    let (mut fixture, client_id) =
+        wheel_binding_fixture("WHEEL_DOWN", EventAction::PRESS, "test_passthrough");
+    let events = scroll_to_client(
+        &mut fixture,
+        client_id,
+        AxisSource::Wheel,
+        Axis::Vertical,
+        Some(15.0),
+        Some(120.0),
+        AxisRelativeDirection::Identical,
+    );
+    assert!(
+        events.contains(&PointerAxisEvent::Value120(
+            wl_pointer::Axis::VerticalScroll,
+            120
+        )),
+        "the client scrolled: {events:?}"
+    );
+}
+
+/// Finger scrolling has no detents, so wheel bindings leave it alone.
+#[test]
+fn wheel_binding_ignores_finger_scroll() {
+    let (mut fixture, client_id) =
+        wheel_binding_fixture("WHEEL_DOWN", EventAction::PRESS, "test_noop_a");
+    let events = scroll_to_client(
+        &mut fixture,
+        client_id,
+        AxisSource::Finger,
+        Axis::Vertical,
+        Some(15.0),
+        None,
+        AxisRelativeDirection::Identical,
+    );
+    assert_eq!(fixture.operator_log_take(), Vec::<String>::new());
+    assert!(
+        events.contains(&PointerAxisEvent::Value(
+            wl_pointer::Axis::VerticalScroll,
+            15.0
+        )),
+        "the client scrolled: {events:?}"
+    );
+}
