diff --git a/src/handler/input/pointer_wheel.rs b/src/handler/input/pointer_wheel.rs
new file mode 100644
index 00000000..e2473abf
--- /dev/null
+++ b/src/handler/input/pointer_wheel.rs
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Scroll-wheel bindings.
+//!
+//! A wheel has no button of its own, so each detent runs the bindings of a
+//! virtual one: `WHEEL_UP` / `WHEEL_DOWN` for the vertical axis,
+//! `WHEEL_LEFT` / `WHEEL_RIGHT` for the horizontal one (tilt wheels). They
+//! bind through `MatchPointer` like any button, which keeps one matcher, one
+//! cascade and one execution path for every pointer trigger.
+//!
+//! A detent is a press with no motion and no release to wait for, so it runs
+//! Press bindings, and Click bindings - `MatchPointer`'s default action - when
+//! no Press binding ran. Release, Drag and DoubleClick never fire for it.
+//!
+//! Only discrete wheel sources step: a touchpad or other continuous scroll
+//! has no detents to count, and goes to the client as before.
+
+use smithay::backend::input::{Axis, AxisSource, PointerAxisEvent};
+
+use crate::input::{
+    BindingFlags, ButtonCode, CascadeLookup, EventAction, InputTrigger, PointerRegion, Timestamp,
+};
+use crate::state::{IonMain, PointerTarget};
+
+/// v120 units per wheel detent, from the `wl_pointer.axis_value120` spec.
+const V120_PER_DETENT: i32 = 120;
+
+/// The event actions a detent runs, in order; the first that runs wins.
+const WHEEL_ACTIONS: [EventAction; 2] = [EventAction::PRESS, EventAction::CLICK];
+
+impl IonMain {
+    /// Run wheel bindings for a pointer axis event, returning the axes whose
+    /// scroll a binding took, `[horizontal, vertical]`. The caller leaves
+    /// those out of the frame it sends the client.
+    ///
+    /// An axis with a binding for its direction is withheld even when the
+    /// event did not complete a detent: a high-resolution wheel reports
+    /// fractions of one, and the client must not scroll by the fractions of
+    /// a detent the compositor goes on to take.
+    pub(super) fn pointer_wheel_bindings<I: smithay::backend::input::InputBackend>(
+        &mut self,
+        event: &impl PointerAxisEvent<I>,
+    ) -> [bool; 2] {
+        let mut taken = [false; 2];
+        if !matches!(event.source(), AxisSource::Wheel | AxisSource::WheelTilt) || self.is_locked()
+        {
+            self.wm.event_state.wheel_v120 = [0; 2];
+            return taken;
+        }
+        let time = Timestamp::from_input_time(event.time());
+        let mod_mask = self.wm.event_state.keyboard_mod_mask;
+
+        for (index, axis) in [Axis::Horizontal, Axis::Vertical].into_iter().enumerate() {
+            let Some(v120) = event.amount_v120(axis).map(|v| v.round() as i32) else {
+                continue;
+            };
+            if v120 == 0 {
+                continue;
+            }
+            let button = wheel_button(axis, v120 > 0);
+            let lookup = self.cascade_lookup(InputTrigger::Pointer(button), mod_mask);
+            if !self.wheel_bound(&lookup) {
+                self.wm.event_state.wheel_v120[index] = 0;
+                continue;
+            }
+
+            // Carry partial detents over, dropping them on a reversal so a
+            // change of direction does not first unwind the old one.
+            let acc = &mut self.wm.event_state.wheel_v120[index];
+            if (*acc > 0) != (v120 > 0) {
+                *acc = 0;
+            }
+            *acc += v120;
+            let detents = *acc / V120_PER_DETENT;
+            *acc %= V120_PER_DETENT;
+
+            // Withheld until a detent shows otherwise: a binding that runs
+            // nothing (its operator passed through) or forwards leaves the
+            // scroll to the client, as with a button.
+            let mut consumed = detents == 0;
+            for _ in 0..detents.unsigned_abs() {
+                // An operator may have moved focus or the layout, so each
+                // detent looks up the keymaps afresh.
+                let lookup = self.cascade_lookup(InputTrigger::Pointer(button), mod_mask);
+                if self
+                    .wheel_detent_run(&lookup, time)
+                    .is_some_and(|flags| !flags.contains(BindingFlags::PASSTHROUGH))
+                {
+                    consumed = true;
+                }
+            }
+            taken[index] = consumed;
+        }
+        taken
+    }
+
+    /// Whether any keymap a detent would search binds `lookup`'s trigger.
+    fn wheel_bound(&self, lookup: &CascadeLookup) -> bool {
+        let probe = |km: &crate::input::Keymap| {
+            WHEEL_ACTIONS
+                .iter()
+                .any(|&action| {
+                    km.trigger_lookup(lookup.trigger, lookup.mod_mask, action)
+                        .is_some()
+                })
+                .then_some(())
+        };
+        if self
+            .registry
+            .keymaps
+            .global_lookup(&lookup.km_ctx, probe)
+            .is_some()
+        {
+            return true;
+        }
+        self.wheel_regions()
+            .iter()
+            .any(|region| self.region_keymap_get(region).and_then(probe).is_some())
+    }
+
+    /// Run one detent: the global keymaps, then the spatial regions under
+    /// the pointer, for each of `WHEEL_ACTIONS` in turn. Returns the flags of
+    /// the binding that ran, or `None` when none did.
+    fn wheel_detent_run(
+        &mut self,
+        lookup: &CascadeLookup,
+        time: Timestamp,
+    ) -> Option<BindingFlags> {
+        let event = self.wm.gen_event(lookup.trigger.to_event_kind(true), time);
+        for action in WHEEL_ACTIONS {
+            if let Some(data) =
+                self.region_cascade_run(lookup, &PointerRegion::Global, action, event)
+            {
+                return Some(data.flags);
+            }
+            for region in self.wheel_regions() {
+                if let Some(data) = self.region_cascade_run(lookup, &region, action, event) {
+                    return Some(data.flags);
+                }
+            }
+        }
+        None
+    }
+
+    /// The spatial regions under the pointer, in cascade order. None over a
+    /// layer surface above the windows or a fullscreen window, as for a
+    /// button press (see `press_spatial_cascade`).
+    fn wheel_regions(&self) -> Vec<PointerRegion> {
+        let blocked = self.pointer_over_cached().is_none_or(|po| {
+            matches!(po.target, PointerTarget::LayerSurfaceAbove) || po.fullscreen_covers
+        });
+        if blocked {
+            return Vec::new();
+        }
+        self.pointer_hit_context().regions().collect()
+    }
+}
+
+/// The virtual button for a detent on `axis`, `positive` being down or right
+/// (the sign the client sees, so natural scrolling flips it).
+fn wheel_button(axis: Axis, positive: bool) -> ButtonCode {
+    match (axis, positive) {
+        (Axis::Vertical, false) => ButtonCode::WHEEL_UP,
+        (Axis::Vertical, true) => ButtonCode::WHEEL_DOWN,
+        (Axis::Horizontal, false) => ButtonCode::WHEEL_LEFT,
+        (Axis::Horizontal, true) => ButtonCode::WHEEL_RIGHT,
+    }
+}
