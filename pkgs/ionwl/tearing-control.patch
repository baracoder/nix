@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Tearing-control (`wp_tearing_control_manager_v1`) tests: a surface's
+//! double-buffered presentation hint, as the frames of an output showing it
+//! fullscreen report it.
+//!
+//! Whether a frame then really flips asynchronously is the DRM backend's
+//! decision against the hardware, which the harness has none of; what is
+//! asserted is the frame's `tearing`, the request the backend acts on.
+
+use ionwl::tiling::OutputId;
+use wayland_client::protocol::wl_surface::WlSurface;
+
+use crate::common::client::PresentationHint;
+use crate::common::{ClientId, Fixture};
+
+/// One output with a client's window fullscreen on it.
+fn fullscreen_fixture() -> (Fixture, OutputId, ClientId, WlSurface) {
+    let mut fixture = Fixture::new();
+    let output_id = fixture.output_add_default();
+    let client = fixture.add_client();
+    let surface = fixture.spawn_window(client);
+    fixture.window_fullscreen_with_margin(client, &surface, 0);
+    (fixture, output_id, client, surface)
+}
+
+/// Commit `surface`, applying its pending hint.
+fn commit(fixture: &mut Fixture, client: ClientId, surface: &WlSurface) {
+    fixture.client(client).window_for_surface(surface).commit();
+    fixture.roundtrip(client);
+}
+
+/// Whether a frame of `output_id` may tear.
+fn tearing(fixture: &mut Fixture, output_id: OutputId) -> bool {
+    fixture.ionwl().frame_collect_test(output_id).tearing
+}
+
+/// The hint applies on the commit after it is set, and `vsync` takes it back.
+#[test]
+fn tearing_control_hint_applies_on_commit() {
+    let (mut fixture, output_id, client, surface) = fullscreen_fixture();
+    assert!(!tearing(&mut fixture, output_id), "vsync is the default");
+
+    let control = fixture.client(client).tearing_control_get(&surface);
+    fixture
+        .client(client)
+        .tearing_control_hint_set(&control, PresentationHint::Async);
+    fixture.roundtrip(client);
+    assert!(
+        !tearing(&mut fixture, output_id),
+        "the hint must wait for the surface's commit"
+    );
+
+    commit(&mut fixture, client, &surface);
+    assert!(tearing(&mut fixture, output_id));
+
+    fixture
+        .client(client)
+        .tearing_control_hint_set(&control, PresentationHint::Vsync);
+    commit(&mut fixture, client, &surface);
+    assert!(!tearing(&mut fixture, output_id));
+}
+
+/// Destroying the control reverts to vsync on the next commit, and frees the
+/// surface for another control.
+#[test]
+fn tearing_control_destroy_reverts_to_vsync() {
+    let (mut fixture, output_id, client, surface) = fullscreen_fixture();
+    let control = fixture.client(client).tearing_control_get(&surface);
+    fixture
+        .client(client)
+        .tearing_control_hint_set(&control, PresentationHint::Async);
+    commit(&mut fixture, client, &surface);
+    assert!(tearing(&mut fixture, output_id));
+
+    fixture.client(client).tearing_control_destroy(&control);
+    fixture.roundtrip(client);
+    assert!(
+        tearing(&mut fixture, output_id),
+        "the revert must wait for the surface's commit"
+    );
+    commit(&mut fixture, client, &surface);
+    assert!(!tearing(&mut fixture, output_id));
+
+    let control = fixture.client(client).tearing_control_get(&surface);
+    fixture
+        .client(client)
+        .tearing_control_hint_set(&control, PresentationHint::Async);
+    commit(&mut fixture, client, &surface);
+    assert!(fixture.client(client).protocol_error().is_none());
+    assert!(tearing(&mut fixture, output_id));
+}
+
+/// Only a window covering the output fullscreen tears: not one in a tile, and
+/// not one hidden behind the lock screen.
+#[test]
+fn tearing_control_only_fullscreen_tears() {
+    let mut fixture = Fixture::new();
+    let output_id = fixture.output_add_default();
+    let client = fixture.add_client();
+    let surface = fixture.spawn_window(client);
+    let control = fixture.client(client).tearing_control_get(&surface);
+    fixture
+        .client(client)
+        .tearing_control_hint_set(&control, PresentationHint::Async);
+    commit(&mut fixture, client, &surface);
+    assert!(
+        !tearing(&mut fixture, output_id),
+        "a tiled window must not tear"
+    );
+
+    fixture.window_fullscreen_with_margin(client, &surface, 0);
+    assert!(tearing(&mut fixture, output_id));
+
+    fixture.session_lock_and_confirm();
+    assert!(
+        !tearing(&mut fixture, output_id),
+        "the lock screen must not tear"
+    );
+}
+
+/// A surface has at most one control: a second is the
+/// `tearing_control_exists` protocol error.
+#[test]
+fn tearing_control_second_control_is_a_protocol_error() {
+    let mut fixture = Fixture::new();
+    fixture.output_add_default();
+    let client = fixture.add_client();
+    let surface = fixture.spawn_window(client);
+    fixture.client(client).tearing_control_get(&surface);
+    fixture.roundtrip(client);
+
+    fixture.client(client).protocol_error_expect();
+    fixture.client(client).tearing_control_get(&surface);
+    fixture.dispatch_until(|fixture| fixture.client(client).protocol_error().is_some());
+    let error = fixture.client(client).protocol_error().unwrap();
+    assert_eq!(
+        (error.object_interface.as_str(), error.code),
+        ("wp_tearing_control_manager_v1", 0),
+        "expected `tearing_control_exists`, got {error:?}"
+    );
+}
