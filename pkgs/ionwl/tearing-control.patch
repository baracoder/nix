@@ -0,0 +1,225 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! tearing-control-v1 protocol implementation.
+//!
+//! Lets a client hint that a surface's content may be presented with tearing
+//! (an asynchronous page flip) for lower latency, as games do. Vulkan and EGL
+//! drivers bind it themselves for an immediate present mode or a zero swap
+//! interval, and Xwayland for X clients flipping asynchronously.
+//!
+//! The hint is double-buffered surface state, applied on `wl_surface.commit`
+//! like the rest. Nothing reacts to the commit: the DRM backend reads the
+//! committed hint of the window an output shows fullscreen when it renders
+//! (see [`tearing_requested`]), and is free to present with vsync anyway.
+//!
+//! Smithay has no implementation, so this follows the shape of its
+//! `content_type` module, another per-surface hint.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use smithay::{
+    reexports::{
+        wayland_protocols::wp::tearing_control::v1::server::{
+            wp_tearing_control_manager_v1::{self, WpTearingControlManagerV1},
+            wp_tearing_control_v1::{self, PresentationHint, WpTearingControlV1},
+        },
+        wayland_server::{
+            Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource, WEnum, Weak,
+            protocol::wl_surface::WlSurface,
+        },
+    },
+    wayland::compositor::{self, Cacheable},
+};
+
+const VERSION: u32 = 1;
+
+/// A surface's committed presentation hint.
+#[derive(Clone, Copy, Debug, Default)]
+struct TearingCachedState {
+    /// The client accepts tearing (`async`); `vsync`, the default, otherwise.
+    tearing: bool,
+}
+
+impl Cacheable for TearingCachedState {
+    fn commit(&mut self, _dh: &DisplayHandle) -> Self {
+        *self
+    }
+
+    fn merge_into(self, into: &mut Self, _dh: &DisplayHandle) {
+        *into = self;
+    }
+}
+
+/// Whether the surface has a `wp_tearing_control_v1`, which it may have only
+/// one of at a time.
+#[derive(Default)]
+struct TearingControlAttached(AtomicBool);
+
+/// Dispatch data of a `wp_tearing_control_v1`: the surface it extends.
+pub struct TearingControlData {
+    surface: Weak<WlSurface>,
+}
+
+/// State for the tearing-control protocol: its global.
+pub struct TearingControlManagerState;
+
+impl TearingControlManagerState {
+    /// Create the state and register the global.
+    pub(crate) fn new<D>(display: &DisplayHandle) -> Self
+    where
+        D: GlobalDispatch<WpTearingControlManagerV1, ()>
+            + Dispatch<WpTearingControlManagerV1, ()>
+            + 'static,
+    {
+        display.create_global::<D, WpTearingControlManagerV1, _>(VERSION, ());
+        Self
+    }
+}
+
+/// Whether `surface`'s committed presentation hint accepts tearing.
+pub fn tearing_requested(surface: &WlSurface) -> bool {
+    compositor::with_states(surface, |states| {
+        states
+            .cached_state
+            .get::<TearingCachedState>()
+            .current()
+            .tearing
+    })
+}
+
+/// Set the pending presentation hint of the surface a control extends, unless
+/// the surface is gone (the control is inert then).
+fn tearing_pending_set(data: &TearingControlData, tearing: bool) {
+    if let Ok(surface) = data.surface.upgrade() {
+        compositor::with_states(&surface, |states| {
+            states
+                .cached_state
+                .get::<TearingCachedState>()
+                .pending()
+                .tearing = tearing;
+        });
+    }
+}
+
+impl<D> GlobalDispatch<WpTearingControlManagerV1, (), D> for TearingControlManagerState
+where
+    D: GlobalDispatch<WpTearingControlManagerV1, ()>
+        + Dispatch<WpTearingControlManagerV1, ()>
+        + 'static,
+{
+    fn bind(
+        _state: &mut D,
+        _handle: &DisplayHandle,
+        _client: &Client,
+        resource: New<WpTearingControlManagerV1>,
+        _global_data: &(),
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        data_init.init(resource, ());
+    }
+}
+
+impl<D> Dispatch<WpTearingControlManagerV1, (), D> for TearingControlManagerState
+where
+    D: Dispatch<WpTearingControlManagerV1, ()>
+        + Dispatch<WpTearingControlV1, TearingControlData>
+        + 'static,
+{
+    fn request(
+        _state: &mut D,
+        _client: &Client,
+        manager: &WpTearingControlManagerV1,
+        request: wp_tearing_control_manager_v1::Request,
+        _data: &(),
+        _dhandle: &DisplayHandle,
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        match request {
+            wp_tearing_control_manager_v1::Request::GetTearingControl { id, surface } => {
+                let exists = compositor::with_states(&surface, |states| {
+                    states
+                        .data_map
+                        .insert_if_missing_threadsafe(TearingControlAttached::default);
+                    states
+                        .data_map
+                        .get::<TearingControlAttached>()
+                        .unwrap()
+                        .0
+                        .swap(true, Ordering::AcqRel)
+                });
+                data_init.init(
+                    id,
+                    TearingControlData {
+                        surface: surface.downgrade(),
+                    },
+                );
+                if exists {
+                    manager.post_error(
+                        wp_tearing_control_manager_v1::Error::TearingControlExists,
+                        "the surface already has a tearing control object",
+                    );
+                }
+            }
+            // The controls it created outlive it.
+            wp_tearing_control_manager_v1::Request::Destroy => {}
+            _ => unreachable!("unhandled wp_tearing_control_manager_v1 request"),
+        }
+    }
+}
+
+impl<D> Dispatch<WpTearingControlV1, TearingControlData, D> for TearingControlManagerState
+where
+    D: Dispatch<WpTearingControlV1, TearingControlData>,
+{
+    fn request(
+        _state: &mut D,
+        _client: &Client,
+        _resource: &WpTearingControlV1,
+        request: wp_tearing_control_v1::Request,
+        data: &TearingControlData,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, D>,
+    ) {
+        match request {
+            wp_tearing_control_v1::Request::SetPresentationHint { hint } => {
+                // An unknown value is a newer protocol's hint: leave the
+                // current one in place.
+                let tearing = match hint {
+                    WEnum::Value(PresentationHint::Async) => true,
+                    WEnum::Value(PresentationHint::Vsync) => false,
+                    _ => return,
+                };
+                tearing_pending_set(data, tearing);
+            }
+            // Reverts to vsync on the next commit, and frees the surface for
+            // another control.
+            wp_tearing_control_v1::Request::Destroy => {
+                tearing_pending_set(data, false);
+                if let Ok(surface) = data.surface.upgrade() {
+                    compositor::with_states(&surface, |states| {
+                        if let Some(attached) = states.data_map.get::<TearingControlAttached>() {
+                            attached.0.store(false, Ordering::Release);
+                        }
+                    });
+                }
+            }
+            _ => unreachable!("unhandled wp_tearing_control_v1 request"),
+        }
+    }
+}
+
+/// Delegate macro for tearing-control.
+#[macro_export]
+macro_rules! delegate_tearing_control {
+    ($ty:ty) => {
+        smithay::reexports::wayland_server::delegate_global_dispatch!($ty: [
+            smithay::reexports::wayland_protocols::wp::tearing_control::v1::server::wp_tearing_control_manager_v1::WpTearingControlManagerV1: ()
+        ] => $crate::protocols::tearing_control::TearingControlManagerState);
+        smithay::reexports::wayland_server::delegate_dispatch!($ty: [
+            smithay::reexports::wayland_protocols::wp::tearing_control::v1::server::wp_tearing_control_manager_v1::WpTearingControlManagerV1: ()
+        ] => $crate::protocols::tearing_control::TearingControlManagerState);
+        smithay::reexports::wayland_server::delegate_dispatch!($ty: [
+            smithay::reexports::wayland_protocols::wp::tearing_control::v1::server::wp_tearing_control_v1::WpTearingControlV1: $crate::protocols::tearing_control::TearingControlData
+        ] => $crate::protocols::tearing_control::TearingControlManagerState);
+    };
+}
