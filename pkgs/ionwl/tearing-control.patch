+#[test]
+fn presentation_from_metadata_tearing_drops_vsync() {
+    // An asynchronous flip did not wait for a vertical blank; the hardware
+    // timing it reports is still advertised.
+    let clock: Clock<Monotonic> = Clock::new();
+    let meta = DrmEventMetadata {
+        time: DrmEventTime::Monotonic(std::time::Duration::from_millis(1234)),
+        sequence: 42,
