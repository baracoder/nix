+#[test]
+fn next_render_time_is_immediate_while_tearing() {
+    // A tearing frame flips on submit rather than at the VBlank the estimate
+    // aims for, so holding its render back would only add latency.
+    let mut timings = full_history(100);
+    timings.tearing_set(true);
+    assert_eq!(
+        timings.next_render_time_since(Duration::from_millis(105)),
+        Duration::ZERO
+    );
+    timings.tearing_set(false);
+    assert_eq!(
+        timings.next_render_time_since(Duration::from_millis(105)),
+        Duration::from_millis(6)
+    );
+}
