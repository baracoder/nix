+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Dragging tiled windows from anywhere on them: `window_drag` and
+//! `frame_resize_drag`.
+
+use super::helpers::{BTN_MIDDLE, pointer_move_to};
+use crate::common::Fixture;
+use ionwl::tiling::SplitAxis;
+
+/// Two windows tabbed in the left frame, the right frame empty, and the
+/// middle button bound to `operator` in the global keymap.
+fn two_frames(operator: &str) -> Fixture {
+    let mut fixture = Fixture::new();
+    fixture.output_add_default();
+    let client_id = fixture.add_client();
+    fixture.spawn_window_with(client_id, |window| window.set_title("first"));
+    fixture.spawn_window_with(client_id, |window| window.set_title("second"));
+    fixture.dispatch();
+    fixture.wm_op(|s| s.wm.frame_split(&s.app, SplitAxis::Horizontal));
+    fixture.dispatch();
+    fixture
+        .python_call("tiled_drag", "binding_add", (operator,))
+        .expect("the binding is added");
+    fixture
+}
+
+fn frame_titles(fixture: &mut Fixture) -> Vec<Vec<String>> {
+    fixture
+        .python_call_ret("tiled_drag", "frame_titles_get", ())
+        .expect("the frames are listed")
+}
+
+fn frame_centers(fixture: &mut Fixture) -> Vec<(i32, i32)> {
+    fixture
+        .python_call_ret("tiled_drag", "frame_centers_get", ())
+        .expect("the frames are listed")
+}
+
+fn split_ratio(fixture: &mut Fixture) -> f64 {
+    fixture
+        .python_call_ret("tiled_drag", "split_ratio_get", ())
+        .expect("the split has a ratio")
+}
+
+/// Press the middle button at `from`, drag to `to` and release.
+fn drag(fixture: &mut Fixture, from: [i32; 2], to: [i32; 2]) {
+    fixture.pointer_simulate_motion(from);
+    fixture.ionwl().pointer_focus_update_test();
+    fixture
+        .ionwl()
+        .pointer_button_input_event_test(BTN_MIDDLE, true);
+    fixture.ionwl().pointer_motion_simulate(5.0, 0.0);
+    assert_eq!(
+        fixture.ionwl().generator_pending_count_test(),
+        1,
+        "precondition: the drag binding started its generator"
+    );
+    pointer_move_to(fixture, to);
+    fixture
+        .ionwl()
+        .pointer_button_input_event_test(BTN_MIDDLE, false);
+    fixture.dispatch();
+}
+
+/// A tiled window grabbed by its content drops into the frame it is
+/// released over.
+#[test]
+fn window_drag_moves_a_tiled_window_to_another_frame() {
+    let mut fixture = two_frames("window_drag");
+    let before = frame_titles(&mut fixture);
+    assert_eq!(before.len(), 2, "precondition: two frames");
+    assert!(
+        !before[0].is_empty(),
+        "precondition: the left frame holds a window"
+    );
+    let centers = frame_centers(&mut fixture);
+    let (left, right) = (centers[0], centers[1]);
+    drag(&mut fixture, [left.0, left.1], [right.0, right.1]);
+    let after = frame_titles(&mut fixture);
+    assert_eq!(
+        (after[0].len() + 1, after[1].len()),
+        (before[0].len(), before[1].len() + 1),
+        "one window must move from the left frame to the right ({before:?} -> {after:?})"
+    );
+}
+
+/// Grabbing a tiled frame anywhere moves the divider beside it: from the
+/// left frame its right edge, from the right frame its left edge.
+#[test]
+fn frame_resize_drag_moves_the_nearest_divider() {
+    for frame in 0..2 {
+        let mut fixture = two_frames("frame_resize_drag");
+        let centers = frame_centers(&mut fixture);
+        let (x, y) = centers[frame];
+        let before = split_ratio(&mut fixture);
+        drag(&mut fixture, [x, y], [x + 105, y]);
+        let after = split_ratio(&mut fixture);
+        assert!(
+            after > before + 0.05,
+            "dragging right from frame {frame} must widen the left frame ({before} -> {after})"
+        );
+    }
+}
