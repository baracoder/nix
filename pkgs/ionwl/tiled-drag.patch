+/// .. function:: tiled_frame_at_pointer()
+///
+///    Query the tiled frame under the pointer, wherever in it the pointer is:
+///    its client, tab bar, border or empty content area.
+///
+///    ``None`` when a floating item, a divider, a layer surface or a
+///    fullscreen window is on top, or no frame is there.
+///
+///    :return: The frame, or ``None``.
+///    :rtype: :class:`~ion.types.Frame` | None
+#[pyfunction(name = "tiled_frame_at_pointer")]
+fn internal_tiled_frame_at_pointer() -> PyResult<Option<PyWmFrame>> {
+    let state = require_state_named("_internal")?;
+    let wm = state.wm();
+    // Cold cache: walk the tiled layout directly. See
+    // `internal_divider_at_pointer` for when the cache is cold.
+    let Some(po) = wm.pointer_over_checked(state.app()) else {
+        let pos = wm.event_state.pointer_location_floor();
+        if wm.floating_item_focus_at_pointer(state.app()).is_some() {
+            return Ok(None);
+        }
+        return Ok(tiled_frame_at(&state.layout(), pos).map(|id| PyWmFrame { id }));
+    };
+    Ok(match po.target {
+        PointerTarget::Tiled { frame_id, .. } => Some(PyWmFrame { id: frame_id }),
+        _ => None,
+    })
+}
+
 /// .. function:: sloppy_focus_update()
