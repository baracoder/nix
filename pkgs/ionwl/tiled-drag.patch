@@ -0,0 +1,108 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""Frame resize generator implementation.
+
+Resizes the window under the pointer, wherever it was grabbed: a floating
+item resizes as with ``floating_resize``, a tiled frame moves the dividers
+nearest the pointer - on each axis, the one on the side of the frame the
+pointer is in, or the other side's when the frame is at the layout edge.
+"""
+
+from __future__ import annotations
+
+__all__ = (
+    "exec_generator",
+)
+
+from collections.abc import Generator
+
+import ion
+from ion.types import (
+    Event,
+    EventCancel,
+    EventMotion,
+    EventPointer,
+    GeneratorStep,
+)
+
+from ion_utils._internal.operators import floating_resize_impl
+
+# Cursors by which edges move: (horizontal side, vertical side), each
+# -1 (min edge), 1 (max edge) or 0 (none on that axis).
+_CURSORS = {
+    (-1, 0): "w-resize", (1, 0): "e-resize",
+    (0, -1): "n-resize", (0, 1): "s-resize",
+    (-1, -1): "nw-resize", (1, -1): "ne-resize",
+    (-1, 1): "sw-resize", (1, 1): "se-resize",
+}
+
+
+def _divider_find(
+    node: ion.types.SplitNode,
+    axis: int,
+    node_is_min_child: bool,
+) -> ion.types.SplitNodeContainer | None:
+    """The divider on *node*'s max edge on *axis* (its min edge when not
+    *node_is_min_child*), or ``None`` at the layout edge."""
+    current = node
+    while (parent := current.parent) is not None:
+        if parent.split_axis == axis and (parent.child_min == current) == node_is_min_child:
+            return parent
+        current = parent
+    return None
+
+
+def exec_generator(
+    event: Event,
+) -> Generator[GeneratorStep, Event]:
+    """Resize the window under the pointer until the button is released."""
+    if ion._internal.floating_item_at_pointer() is not None:
+        return (yield from floating_resize_impl.exec_generator(event, border=False))
+
+    frame = ion._internal.tiled_frame_at_pointer()
+    if frame is None:
+        return None
+    node = frame.split_node
+    if node is None:
+        return None
+
+    assert isinstance(event, EventPointer)
+    grab_button = event.button
+    start = event.position.copy()
+    rect = node.rect
+
+    # (divider, axis, ratio at the start, pixels per unit ratio).
+    dividers = []
+    sides = [0, 0]
+    for axis in (0, 1):
+        towards_max = start[axis] * 2 >= rect.min[axis] + rect.max[axis]
+        divider = _divider_find(node, axis, towards_max)
+        if divider is None:
+            towards_max = not towards_max
+            divider = _divider_find(node, axis, towards_max)
+        if divider is None:
+            continue
+        dim = divider.rect.size[axis]
+        if dim <= 0:
+            continue
+        dividers.append((divider, axis, divider.split_ratio, dim))
+        sides[axis] = 1 if towards_max else -1
+
+    if not dividers:
+        return None
+
+    ion.wm.cursor_push(_CURSORS[(sides[0], sides[1])])
+
+    while True:
+        event = yield GeneratorStep(consume_event=True)
+
+        if isinstance(event, EventCancel):
+            return
+
+        if isinstance(event, EventPointer) and not event.press and event.button == grab_button:
+            return
+
+        if isinstance(event, (EventMotion, EventPointer)):
+            for divider, axis, ratio, dim in dividers:
+                if divider.is_valid:
+                    divider.split_ratio = ratio + (event.position[axis] - start[axis]) / dim
