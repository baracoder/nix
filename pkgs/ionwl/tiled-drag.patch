+# SPDX-License-Identifier: GPL-3.0-or-later
+
+# Python halves of the tests in `tiled_drag.rs`.
+
+import ion
+import ion.constants.event_actions as ea
+import ion.constants.pointer_buttons as btn
+import ion.ops as ops
+from ion.types import DesktopItemTilingWorkspace, Frame, MatchPointer, SplitNodeContainer
+
+
+def binding_add(operator: str) -> None:
+    ion.app.keymaps['global'].items.new(
+        MatchPointer(btn.MIDDLE, action=ea.DRAG),
+        operator=getattr(ops, operator)(),
+    )
+
+
+def _frames() -> list[Frame]:
+    item = ion.wm.desktops.active.items_tiling[0]
+    assert isinstance(item, DesktopItemTilingWorkspace), "the desktop tiles a workspace"
+    return list(item.workspace.frames)
+
+
+def _min_x(frame: Frame) -> int:
+    rect = frame.content_rect
+    assert rect is not None, "a tiled frame has a content rect"
+    return rect.min.x
+
+
+def frame_titles_get() -> list[list[str]]:
+    """The window titles of each frame, left to right."""
+    return [[w.title for w in f.windows] for f in sorted(_frames(), key=_min_x)]
+
+
+def frame_centers_get() -> list[tuple[int, int]]:
+    """Each frame's content center, left to right."""
+    centers = []
+    for frame in sorted(_frames(), key=_min_x):
+        rect = frame.content_rect
+        assert rect is not None
+        centers.append(rect.center_floor().to_tuple())
+    return centers
+
+
+def split_ratio_get() -> float:
+    node = _frames()[0].split_node
+    assert node is not None
+    parent = node.parent
+    assert isinstance(parent, SplitNodeContainer), "the frames share a split"
+    return parent.split_ratio
