@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""Window drag generator implementation.
+
+Moves the window under the pointer, wherever it was grabbed: a floating
+item moves as with ``floating_move``, a tiled window is dragged as its tab,
+to be dropped into another frame (or onto empty space to float it).
+"""
+
+from __future__ import annotations
+
+__all__ = (
+    "exec_generator",
+)
+
+from collections.abc import Generator
+
+import ion
+from ion.types import Event, EventPointer, GeneratorStep, Point, Rect
+
+from ion_utils._internal.operators import floating_move_impl, frame_tab_drag_impl
+
+# Ghost tab size when the frame shows no tabs to take it from.
+_GHOST_SIZE_FALLBACK = (200, 24)
+
+
+def exec_generator(
+    event: Event,
+) -> Generator[GeneratorStep, Event]:
+    """Move the window under the pointer until the button is released."""
+    if ion._internal.floating_item_at_pointer() is not None:
+        return (yield from floating_move_impl.exec_generator(event))
+
+    frame = ion._internal.tiled_frame_at_pointer()
+    if frame is None:
+        return None
+    window = frame.windows.active
+    if window is None:
+        return None
+
+    assert isinstance(event, EventPointer)
+    # The window's own tab gives the ghost its size; it is held by its
+    # middle, not where the window was grabbed, which may be far from it.
+    slot = ion._internal.tab_drop_slot(frame, frame.active_index, window)
+    size = Point(slot.size.to_tuple() if slot is not None else _GHOST_SIZE_FALLBACK)
+    grab_offset = Point((size.x // 2, size.y // 2))
+    tab_rect = Rect((0, 0), size)
+    return (yield from frame_tab_drag_impl.drag_generator(event, window, frame, tab_rect, grab_offset))
