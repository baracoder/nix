diff --git a/tests/integration/api/desktop_swipe.rs b/tests/integration/api/desktop_swipe.rs
new file mode 100644
index 00000000..90a13b3b
--- /dev/null
+++ b/tests/integration/api/desktop_swipe.rs
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Switching desktops with a touchpad or touchscreen swipe: the
+//! `gesture_swipe_*` hooks and the desktop switch `setup_defaults` attaches
+//! to them.
+
+use std::time::Duration;
+
+use super::helpers::{desktop_active_name, desktop_add};
+use crate::common::{ClientId, DEFAULT_OUTPUT_W, Fixture, PointerGestureEvent, TouchEvent};
+
+/// Long enough for a swipe's settle animation to finish.
+const SETTLE_WAIT: Duration = Duration::from_millis(3000);
+
+/// A gesture client on a desktop beside a second one, with swipes of
+/// `fingers` fingers switching desktops.
+fn swipe_fixture(fingers: u32) -> (Fixture, ClientId) {
+    let mut fixture = Fixture::new();
+    fixture.output_add_default();
+    let client_id = fixture.add_client();
+    fixture.spawn_window(client_id);
+    fixture.deferred_process();
+    fixture.client(client_id).pointer_gestures_get();
+    fixture.pointer_simulate_motion([100, 100]);
+    fixture.ionwl().pointer_focus_update_test();
+    fixture.roundtrip(client_id);
+    desktop_add(&mut fixture, "right");
+    fixture
+        .python_call("desktop_swipe", "setup", (fingers,))
+        .expect("the swipe is set up");
+    (fixture, client_id)
+}
+
+fn swipe(fixture: &mut Fixture, fingers: u32, dx: f64, cancelled: bool) {
+    fixture.ionwl().gesture_swipe_begin_simulate(fingers);
+    for _ in 0..10 {
+        fixture
+            .ionwl()
+            .gesture_swipe_update_simulate(dx / 10.0, 0.0);
+    }
+    // Let the view follow the fingers before they lift.
+    fixture
+        .ionwl()
+        .generators_run_until_test(Duration::from_millis(50), |_| false);
+    fixture.ionwl().gesture_swipe_end_simulate(cancelled);
+    fixture
+        .ionwl()
+        .generators_run_until_test(SETTLE_WAIT, |s| s.generator_pending_count_test() == 0);
+}
+
+/// A swipe with the configured finger count switches to the desktop it
+/// brings in and never reaches the client; one with another count does.
+#[test]
+fn gesture_swipe_switches_desktop() {
+    let (mut fixture, client_id) = swipe_fixture(4);
+    let name = desktop_active_name(&mut fixture);
+    swipe(&mut fixture, 4, -300.0, false);
+    assert_eq!(desktop_active_name(&mut fixture), "right", "from {name}");
+    fixture.roundtrip(client_id);
+    assert_eq!(
+        fixture.client(client_id).pointer_gesture_events_take(),
+        [],
+        "the client must not see the compositor's swipe"
+    );
+
+    // Back again, the other way.
+    swipe(&mut fixture, 4, 300.0, false);
+    assert_eq!(desktop_active_name(&mut fixture), name);
+
+    // A three-finger swipe is the client's.
+    swipe(&mut fixture, 3, -300.0, false);
+    assert_eq!(desktop_active_name(&mut fixture), name);
+    fixture.roundtrip(client_id);
+    assert_eq!(
+        fixture
+            .client(client_id)
+            .pointer_gesture_events_take()
+            .first(),
+        Some(&PointerGestureEvent::SwipeBegin { fingers: 3 }),
+    );
+}
+
+/// A short swipe, a cancelled one, or one towards no desktop settles back.
+#[test]
+fn gesture_swipe_settles_back() {
+    let (mut fixture, _client_id) = swipe_fixture(4);
+    let name = desktop_active_name(&mut fixture);
+    swipe(&mut fixture, 4, -40.0, false);
+    assert_eq!(desktop_active_name(&mut fixture), name, "too short");
+    swipe(&mut fixture, 4, -300.0, true);
+    assert_eq!(desktop_active_name(&mut fixture), name, "cancelled");
+    swipe(&mut fixture, 4, 300.0, false);
+    assert_eq!(
+        desktop_active_name(&mut fixture),
+        name,
+        "no desktop to the left"
+    );
+}
+
+/// Put `fingers` fingers down on the touchscreen in a row, move them all by
+/// `dx` and lift them, then let the view settle.
+fn touch_swipe(fixture: &mut Fixture, fingers: u32, dx: i32) {
+    let at = |finger: u32, offset: i32| [400 + 60 * finger as i32 + offset, 400];
+    for finger in 0..fingers {
+        fixture.ionwl().touch_down_simulate(finger, at(finger, 0));
+        fixture.ionwl().touch_frame_simulate();
+    }
+    for step in 1..=10 {
+        for finger in 0..fingers {
+            fixture
+                .ionwl()
+                .touch_motion_simulate(finger, at(finger, dx * step / 10));
+        }
+        fixture.ionwl().touch_frame_simulate();
+    }
+    fixture
+        .ionwl()
+        .generators_run_until_test(Duration::from_millis(50), |_| false);
+    for finger in 0..fingers {
+        fixture.ionwl().touch_up_simulate(finger);
+        fixture.ionwl().touch_frame_simulate();
+    }
+    fixture
+        .ionwl()
+        .generators_run_until_test(SETTLE_WAIT, |s| s.generator_pending_count_test() == 0);
+}
+
+/// Four fingers on the touchscreen switch desktop, the desktops following
+/// them; the client sees its touches cancelled as the fourth goes down, and
+/// nothing after. Three fingers stay the client's.
+#[test]
+fn touch_swipe_switches_desktop() {
+    let (mut fixture, client_id) = swipe_fixture(4);
+    let name = desktop_active_name(&mut fixture);
+    fixture.roundtrip(client_id);
+    fixture.client(client_id).touch_events_take();
+
+    touch_swipe(&mut fixture, 4, -DEFAULT_OUTPUT_W / 2);
+    assert_eq!(desktop_active_name(&mut fixture), "right", "from {name}");
+    fixture.roundtrip(client_id);
+    let events = fixture.client(client_id).touch_events_take();
+    let downs = events
+        .iter()
+        .filter(|e| matches!(e, TouchEvent::Down(..)))
+        .count();
+    assert_eq!(
+        downs, 4,
+        "the fingers go down in the client before the cancel: {events:?}"
+    );
+    assert!(
+        events.contains(&TouchEvent::Cancel),
+        "the client's touches must be cancelled: {events:?}"
+    );
+    assert!(
+        !events
+            .iter()
+            .any(|e| matches!(e, TouchEvent::Motion(..) | TouchEvent::Up(..))),
+        "nothing after the cancel reaches the client: {events:?}"
+    );
+
+    // Too short a swipe settles back.
+    touch_swipe(&mut fixture, 4, DEFAULT_OUTPUT_W / 10);
+    assert_eq!(desktop_active_name(&mut fixture), "right");
+
+    // Three fingers switch nothing.
+    touch_swipe(&mut fixture, 3, DEFAULT_OUTPUT_W / 2);
+    assert_eq!(desktop_active_name(&mut fixture), "right");
+}
