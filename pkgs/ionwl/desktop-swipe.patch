+# SPDX-License-Identifier: GPL-3.0-or-later
+
+# Python halves of the tests in `desktop_swipe.rs`.
+
+import ion
+
+
+def setup(fingers: int) -> None:
+    from ion_utils._internal import desktop_swipe
+    # Twice: attaching must not double the callbacks.
+    desktop_swipe.hooks_attach()
+    desktop_swipe.hooks_attach()
+    ion.app.preferences.input.touchpad_defaults.gesture_swipe_fingers = fingers
