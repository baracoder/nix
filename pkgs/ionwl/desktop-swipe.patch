--- a/src/handler/input/touch.rs
+++ b/src/handler/input/touch.rs
@@ -1,13 +1,114 @@
 // SPDX-License-Identifier: GPL-3.0-or-later
 
 //! Touch event handlers.
+//!
+//! As many fingers on the touchscreen as
+//! `TouchpadPrefs::gesture_swipe_fingers` make a swipe the compositor keeps,
+//! as on a touchpad: the touches they made so far are cancelled in the
+//! client, and from then until the last finger lifts their mean motion fires
+//! the `gesture_swipe_*` hooks.
 
-use smithay::backend::input::{TouchDownEvent, TouchMotionEvent};
-use smithay::utils::SERIAL_COUNTER;
+use smithay::backend::input::{InputTime, TouchDownEvent, TouchMotionEvent, TouchSlot};
+use smithay::utils::{Logical, Point, SERIAL_COUNTER};
 
+use crate::python::HookEvent;
 use crate::state::IonMain;
 
 impl IonMain {
+    /// The mean position of the touch points down, `None` with none down.
+    fn touch_centroid(&self) -> Option<Point<f64, Logical>> {
+        let points = &self.wm.event_state.touch_points;
+        let count = points.len() as f64;
+        (count > 0.0).then(|| {
+            let sum = points
+                .values()
+                .fold(Point::from((0.0, 0.0)), |sum, p| sum + *p);
+            Point::from((sum.x / count, sum.y / count))
+        })
+    }
+
+    /// Record a touch point going down. Returns whether it belongs to a
+    /// touchscreen swipe, starting one when it is the finger that makes
+    /// enough, in which case it goes no further.
+    pub(super) fn touch_swipe_down(
+        &mut self,
+        slot: TouchSlot,
+        pos: Point<f64, Logical>,
+        time: InputTime,
+    ) -> bool {
+        self.wm.event_state.touch_points.insert(slot, pos);
+        if self.wm.event_state.touch_swipe_centroid.is_some() {
+            // A finger joining the swipe moves the mean, not the view.
+            self.wm.event_state.touch_swipe_centroid = self.touch_centroid();
+            return true;
+        }
+        let fingers = self.wm.event_state.touch_points.len() as u32;
+        if !self.gesture_swipe_holds(fingers) {
+            return false;
+        }
+        // The fingers so far were the client's: take them back. Smithay
+        // cancels only within a frame that has events, so this finger goes
+        // down in the client too, and is cancelled along with the rest.
+        if let Some(touch) = self.wm.seat.get_touch() {
+            let surface_under = self.surface_under(pos);
+            touch.down(
+                self,
+                surface_under,
+                &smithay::input::touch::DownEvent {
+                    slot,
+                    location: pos,
+                    serial: SERIAL_COUNTER.next_serial(),
+                    time,
+                },
+            );
+            touch.cancel(self);
+        }
+        self.wm.event_state.touch_swipe_centroid = self.touch_centroid();
+        self.hook_invoke(HookEvent::GestureSwipeBegin(fingers, true));
+        true
+    }
+
+    /// Record a touch point moving. Returns whether it belongs to a
+    /// touchscreen swipe, firing the update for the fingers' mean motion.
+    pub(super) fn touch_swipe_motion(&mut self, slot: TouchSlot, pos: Point<f64, Logical>) -> bool {
+        self.wm.event_state.touch_points.insert(slot, pos);
+        let Some(last) = self.wm.event_state.touch_swipe_centroid else {
+            return false;
+        };
+        let Some(centroid) = self.touch_centroid() else {
+            return true;
+        };
+        self.wm.event_state.touch_swipe_centroid = Some(centroid);
+        let delta = centroid - last;
+        if delta.x != 0.0 || delta.y != 0.0 {
+            self.hook_invoke(HookEvent::GestureSwipeUpdate(delta.x, delta.y));
+        }
+        true
+    }
+
+    /// Record a touch point lifting. Returns whether it belonged to a
+    /// touchscreen swipe, which the last finger lifting ends.
+    pub(super) fn touch_swipe_up(&mut self, slot: TouchSlot) -> bool {
+        self.wm.event_state.touch_points.remove(&slot);
+        if self.wm.event_state.touch_swipe_centroid.is_none() {
+            return false;
+        }
+        // A finger leaving moves the mean, not the view.
+        self.wm.event_state.touch_swipe_centroid = self.touch_centroid();
+        if self.wm.event_state.touch_swipe_centroid.is_none() {
+            self.hook_invoke(HookEvent::GestureSwipeEnd(false));
+        }
+        true
+    }
+
+    /// Forget every touch point, ending a touchscreen swipe as cancelled.
+    pub(super) fn touch_swipe_cancel(&mut self) {
+        self.wm.event_state.touch_points.clear();
+        if self.wm.event_state.touch_swipe_centroid.take().is_some() {
+            self.hook_invoke(HookEvent::GestureSwipeEnd(true));
+        }
+    }
+
     /// Handle touch down event.
     pub(super) fn handle_touch_down<I: smithay::backend::input::InputBackend>(
         &mut self,
