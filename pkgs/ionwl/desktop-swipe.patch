@@ -0,0 +1,282 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+"""Switch desktops with a touchpad or touchscreen swipe.
+
+The desktops lie side by side, as the desktop slide draws them, and follow
+the fingers: lifting them past a quarter of the way, or flicking, finishes
+the switch, and otherwise the view settles back. A swipe that starts while
+the view is still settling takes it from where it is. On a touchscreen the
+desktops stay under the fingers.
+
+Driven by the ``gesture_swipe_*`` hooks, which fire for swipes with
+``preferences.input.touchpad_defaults.gesture_swipe_fingers`` fingers.
+"""
+
+from __future__ import annotations
+
+__all__ = (
+    "hooks_attach",
+)
+
+import time
+from collections.abc import Generator
+from contextlib import suppress
+from typing import Final
+
+import ion
+from ion.types import (
+    ColorRGBA,
+    Desktop,
+    Event,
+    EventCancel,
+    EventTimer,
+    GeneratorStep,
+    OverlayDesktop,
+    OverlayRect,
+    Point,
+)
+
+from ion_utils._internal.desktop_layout import DesktopLayout
+from ion_utils._internal.operators import SLIDE_STEP_MS, OverlayScope
+
+# Touchpad units for a swipe across a whole desktop (GNOME's touchpad base
+# distance).
+_TOUCHPAD_DISTANCE: Final = 400.0
+# Units (touchpad units or pixels) the fingers travel before the swipe picks
+# its axis.
+_AXIS_LOCK_DISTANCE: Final = 8.0
+# Fraction of a desktop past which lifting the fingers switches.
+_SWITCH_THRESHOLD: Final = 0.25
+# Speed (desktops per second) past which a flick switches regardless.
+_FLICK_SPEED: Final = 1.5
+# How far the view gives past the last desktop, as a fraction of one.
+_OVERSHOOT: Final = 0.1
+# Window (seconds) of recent motion the release speed is measured over.
+_SPEED_WINDOW: Final = 0.1
+
+_ALIGN_MIN: Final = -1
+
+
+class _Swipe:
+    """The swipe in progress, shared between the hooks and the generator."""
+
+    __slots__ = (
+        "active", "axis", "cancelled", "distance", "fingers_down", "motion", "pending", "samples",
+    )
+
+    def __init__(self) -> None:
+        # The generator is running.
+        self.active = False
+        # The fingers are on the touchpad or screen.
+        self.fingers_down = False
+        # Units of finger motion across a whole desktop, per axis.
+        self.distance = (_TOUCHPAD_DISTANCE, _TOUCHPAD_DISTANCE)
+        # The swipe ended cancelled, so the view settles back.
+        self.cancelled = False
+        # Motion not yet picked up by the generator, (dx, dy).
+        self.pending = [0.0, 0.0]
+        # Locked axis, 0 horizontal, 1 vertical, once picked.
+        self.axis: int | None = None
+        # Motion before the axis is picked.
+        self.motion = [0.0, 0.0]
+        # (time, delta along the axis) of recent updates, for the release speed.
+        self.samples: list[tuple[float, float]] = []
+
+    def speed(self) -> float:
+        """Recent finger speed along the axis, in desktops per second."""
+        now = time.monotonic()
+        recent = [d for t, d in self.samples if now - t <= _SPEED_WINDOW]
+        axis = self.axis if self.axis is not None else 0
+        return sum(recent) / self.distance[axis] / _SPEED_WINDOW
+
+
+_swipe = _Swipe()
+
+
+def _on_begin(_fingers: int, touch: bool) -> None:
+    _swipe.distance = (_TOUCHPAD_DISTANCE, _TOUCHPAD_DISTANCE)
+    if touch and (bounds := ion.wm.outputs.bounds_calc()) is not None:
+        # Finger motion is in pixels: a desktop's width moves one desktop.
+        _swipe.distance = (float(max(bounds.size.x, 1)), float(max(bounds.size.y, 1)))
+    _swipe.fingers_down = True
+    _swipe.cancelled = False
+    _swipe.pending = [0.0, 0.0]
+    _swipe.samples.clear()
+    if _swipe.active:
+        # Caught while settling: the running generator picks the view up.
+        return
+    _swipe.axis = None
+    _swipe.motion = [0.0, 0.0]
+    _swipe.active = True
+    ion.utils.exec_generator(_generator())
+
+
+def _on_update(dx: float, dy: float) -> None:
+    if not _swipe.fingers_down:
+        return
+    if _swipe.axis is None:
+        _swipe.motion[0] += dx
+        _swipe.motion[1] += dy
+        mx, my = abs(_swipe.motion[0]), abs(_swipe.motion[1])
+        if max(mx, my) < _AXIS_LOCK_DISTANCE:
+            return
+        _swipe.axis = 0 if mx >= my else 1
+        dx, dy = _swipe.motion
+    _swipe.pending[0] += dx
+    _swipe.pending[1] += dy
+    _swipe.samples.append((time.monotonic(), (dx, dy)[_swipe.axis]))
+    del _swipe.samples[:-32]
+
+
+def _on_end(cancelled: bool) -> None:
+    if not _swipe.fingers_down:
+        return
+    _swipe.fingers_down = False
+    _swipe.cancelled = cancelled
+
+
+def hooks_attach() -> None:
+    """Attach the swipe to the ``gesture_swipe_*`` hooks, once however often
+    it is called."""
+    hooks = ion.app.hooks
+    for hook, callback in (
+        (hooks.gesture_swipe_begin, _on_begin),
+        (hooks.gesture_swipe_update, _on_update),
+        (hooks.gesture_swipe_end, _on_end),
+    ):
+        with suppress(ValueError):
+            hook.remove(callback)
+        hook.append(callback)
+
+
+def _ease_out(t: float) -> float:
+    return 1.0 - (1.0 - t) ** 3
+
+
+def _generator() -> Generator[GeneratorStep, Event]:
+    try:
+        yield from _run()
+    finally:
+        _swipe.active = False
+
+
+def _run() -> Generator[GeneratorStep, Event]:
+    active = ion.wm.desktops.active
+    bounds = ion.wm.outputs.bounds_calc()
+    desktops = list(ion.wm.desktops)
+    dl = DesktopLayout(ion.wm.desktops.layout_calc())
+    if bounds is None or dl.position(active) is None:
+        # Nothing to slide; the fingers still belong to the swipe.
+        while _swipe.fingers_down:
+            ev = yield GeneratorStep(time=SLIDE_STEP_MS, consume_event=True)
+            if isinstance(ev, EventCancel):
+                return
+        return
+
+    size = (bounds.size.x, bounds.size.y)
+
+    # The view's position along the axis, in desktops: +1 is the neighbor to
+    # the right (or below), whose content comes in as the fingers move left.
+    progress = 0.0
+    # Released: where the view settles, where it set off from, and how far
+    # into that it is (ms).
+    settle: tuple[float, float, int, int] | None = None
+
+    with OverlayScope() as scope:
+        overlays: list[tuple[OverlayDesktop, Point]] = []
+        for d in desktops:
+            if dl.position(d) is None:
+                continue
+            ox, oy = dl.desktop_offset(d, active)
+            start = bounds.min + Point((round(ox * size[0]), round(oy * size[1])))
+            ov = OverlayDesktop(d)
+            ov.position = start
+            ov.align = (_ALIGN_MIN, _ALIGN_MIN)
+            scope.append(ov)
+            overlays.append((ov, start))
+
+        # Opaque background hiding the live desktop beneath the overlays.
+        bg = OverlayRect()
+        bg.rect = bounds
+        bg.fill_color = ColorRGBA((0.0, 0.0, 0.0, 1.0))
+        scope.append(bg)
+
+        while True:
+            ev = yield GeneratorStep(time=SLIDE_STEP_MS, consume_event=True)
+            if isinstance(ev, EventCancel):
+                return
+            if not isinstance(ev, EventTimer):
+                continue
+
+            axis = _swipe.axis
+            if axis is None:
+                if not _swipe.fingers_down:
+                    # Lifted before choosing a direction.
+                    return
+                continue
+
+            back = dl.find_adjacent(active, "LEFT" if axis == 0 else "UP", wrap=False)
+            ahead = dl.find_adjacent(active, "RIGHT" if axis == 0 else "DOWN", wrap=False)
+            lo = -1.0 if back is not None else -_OVERSHOOT
+            hi = 1.0 if ahead is not None else _OVERSHOOT
+
+            if _swipe.fingers_down:
+                settle = None
+                # Content follows the fingers: moving them left brings in the
+                # desktop to the right.
+                delta = _swipe.pending[axis]
+                _swipe.pending = [0.0, 0.0]
+                progress = min(max(progress - delta / _swipe.distance[axis], lo), hi)
+            else:
+                if settle is None:
+                    target = 0.0 if _swipe.cancelled else _target_pick(
+                        progress, -_swipe.speed(), back, ahead,
+                    )
+                    distance = abs(target - progress)
+                    duration = max(
+                        round(ion.app.preferences.animate.desktop_slide_duration * distance),
+                        SLIDE_STEP_MS,
+                    )
+                    settle = (target, progress, duration, 0)
+                target, origin, duration, elapsed = settle
+                elapsed += SLIDE_STEP_MS
+                t = min(elapsed / duration, 1.0)
+                progress = origin + (target - origin) * _ease_out(t)
+                settle = (target, origin, duration, elapsed)
+                if t >= 1.0:
+                    if target > 0 and ahead is not None:
+                        ahead.focus()
+                    elif target < 0 and back is not None:
+                        back.focus()
+                    return
+
+            shift = [0, 0]
+            shift[axis] = -round(progress * size[axis])
+            for ov, start in overlays:
+                ov.position = start + Point((shift[0], shift[1]))
+
+
+def _target_pick(
+    progress: float,
+    speed: float,
+    back: Desktop | None,
+    ahead: Desktop | None,
+) -> float:
+    """Where a released view settles: -1, 0 or 1 desktops along the axis.
+
+    *speed* is the view's own, in desktops per second, positive towards
+    *ahead*.
+    """
+    if speed > _FLICK_SPEED and progress > -_SWITCH_THRESHOLD:
+        target = 1.0
+    elif speed < -_FLICK_SPEED and progress < _SWITCH_THRESHOLD:
+        target = -1.0
+    elif progress > _SWITCH_THRESHOLD:
+        target = 1.0
+    elif progress < -_SWITCH_THRESHOLD:
+        target = -1.0
+    else:
+        target = 0.0
+    if (target > 0 and ahead is None) or (target < 0 and back is None):
+        target = 0.0
+    return target
