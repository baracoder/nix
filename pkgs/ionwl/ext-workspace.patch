+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! ext-workspace handler: publishes the desktops and applies client requests.
+
+use std::collections::HashSet;
+
+use tracing::debug;
+
+use super::IonMain;
+use crate::protocols::{
+    ExtWorkspaceHandler, ExtWorkspaceManagerState, WorkspaceInfo, WorkspaceRequest,
+};
+use crate::tiling::DesktopId;
+
+impl ExtWorkspaceHandler for IonMain {
+    fn ext_workspace_state(&mut self) -> &mut ExtWorkspaceManagerState {
+        &mut self.wm.protocol_managers.ext_workspace_state
+    }
+
+    fn ext_workspace_commit(&mut self, requests: Vec<WorkspaceRequest>) {
+        for request in requests {
+            debug!("ext-workspace: {request:?}");
+            match request {
+                WorkspaceRequest::Activate(id) => self.desktop_activate(DesktopId::from_u64(id)),
+                WorkspaceRequest::Remove(id) => {
+                    self.desktop_remove_checked(DesktopId::from_u64(id));
+                }
+                WorkspaceRequest::Create(name) => self.desktop_create(&name),
+            }
+        }
+    }
+}
+
+impl IonMain {
+    /// Publish the desktops and outputs to ext-workspace clients.
+    ///
+    /// Runs once per main-loop iteration rather than from the mutation sites:
+    /// a desktop's name, its order, which is active, its windows' urgency and
+    /// the outputs all move from many places, and the whole state is a few
+    /// desktops. The publish is a diff, so an iteration that changed none of
+    /// it sends nothing.
+    pub(crate) fn ext_workspace_refresh(&mut self) {
+        let (workspaces, outputs) = {
+            let scene = self.wm.scene.read();
+            let layout = &scene.layout;
+            let urgent: HashSet<usize> = layout
+                .windows
+                .iter()
+                .filter(|(_, window)| window.urgent)
+                .filter_map(|(window_id, _)| layout.desktop_find_by_window(window_id))
+                .collect();
+            let active = layout.desktop_active();
+            let workspaces = layout
+                .desktops
+                .iter()
+                .enumerate()
+                .map(|(index, desktop)| WorkspaceInfo {
+                    id: desktop.id.as_u64(),
+                    name: desktop.name.clone(),
+                    active: index == active,
+                    urgent: urgent.contains(&index),
+                })
+                .collect();
+            let mut outputs: Vec<_> = scene.outputs.iter().collect();
+            outputs.sort_by_key(|(output_id, _)| **output_id);
+            let outputs = outputs
+                .into_iter()
+                .map(|(_, co)| co.output.clone())
+                .collect();
+            (workspaces, outputs)
+        };
+        self.wm
+            .protocol_managers
+            .ext_workspace_state
+            .refresh::<Self>(workspaces, outputs);
+    }
+}
diff --git a/src/protocols/ext_workspace.rs b/src/protocols/ext_workspace.rs
