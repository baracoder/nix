--- /dev/null
+++ b/src/protocols/ext_workspace.rs
@@ -0,0 +1,444 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! ext-workspace-v1 protocol implementation.
+//!
+//! Lets bars and docks list workspaces and switch between them.
+//!
+//! ## Model
+//!
+//! A desktop spans every output, so ionwl advertises a single workspace
+//! group that every output enters, and one workspace per desktop in it, in
+//! desktop order. The active desktop is the one `active` workspace. Each
+//! workspace reports its index in the desktop list as its coordinates, and
+//! no `id`: desktop ids restart with the compositor, which the protocol
+//! reserves `id` against.
+//!
+//! Clients can activate a workspace, remove one (refused, as from Python, for
+//! the last desktop or one holding windows) and create one in the group.
+//! Deactivating has no meaning with exactly one desktop active, and there is
+//! one group to assign to, so neither capability is advertised.
+//!
+//! ## Updates
+//!
+//! The compositor publishes the full desktop and output lists through
+//! [`ExtWorkspaceManagerState::refresh`], which diffs them against what each
+//! bound manager was last sent and sends only the changes, closed by `done`.
+
+use smithay::{
+    output::Output,
+    reexports::{
+        wayland_protocols::ext::workspace::v1::server::{
+            ext_workspace_group_handle_v1::{self, ExtWorkspaceGroupHandleV1, GroupCapabilities},
+            ext_workspace_handle_v1::{self, ExtWorkspaceHandleV1, WorkspaceCapabilities},
+            ext_workspace_manager_v1::{self, ExtWorkspaceManagerV1},
+        },
+        wayland_server::{
+            Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource,
+            backend::ClientId, protocol::wl_output::WlOutput,
+        },
+    },
+};
+use tracing::warn;
+
+const VERSION: u32 = 1;
+
+/// One desktop as clients see it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct WorkspaceInfo {
+    /// The desktop's id, which names it in [`WorkspaceRequest`]s.
+    pub id: u64,
+    pub name: String,
+    pub active: bool,
+    /// A window on the desktop wants attention.
+    pub urgent: bool,
+}
+
+impl WorkspaceInfo {
+    fn state(&self) -> ext_workspace_handle_v1::State {
+        let mut state = ext_workspace_handle_v1::State::empty();
+        if self.active {
+            state |= ext_workspace_handle_v1::State::Active;
+        }
+        if self.urgent {
+            state |= ext_workspace_handle_v1::State::Urgent;
+        }
+        state
+    }
+}
+
+/// A request a client made, applied on its `commit`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum WorkspaceRequest {
+    /// Switch to the desktop with this id.
+    Activate(u64),
+    /// Remove the desktop with this id.
+    Remove(u64),
+    /// Create a desktop with this name.
+    Create(String),
+}
+
+/// Handler trait for ext-workspace.
+pub trait ExtWorkspaceHandler {
+    fn ext_workspace_state(&mut self) -> &mut ExtWorkspaceManagerState;
+
+    /// Apply the requests a client committed, in the order it made them.
+    fn ext_workspace_commit(&mut self, requests: Vec<WorkspaceRequest>);
+}
+
+/// Dispatch data of a workspace group: the manager it was sent through.
+pub struct WorkspaceGroupData {
+    manager: ExtWorkspaceManagerV1,
+}
+
+/// Dispatch data of a workspace: its desktop and the manager it was sent
+/// through.
+pub struct WorkspaceData {
+    id: u64,
+    manager: ExtWorkspaceManagerV1,
+}
+
+/// What one bound manager has been sent.
+struct Instance {
+    manager: ExtWorkspaceManagerV1,
+    group: ExtWorkspaceGroupHandleV1,
+    /// Each workspace sent, with the info and index it was last sent.
+    workspaces: Vec<(ExtWorkspaceHandleV1, WorkspaceInfo, usize)>,
+    /// The outputs the group was sent `output_enter` for.
+    outputs: Vec<WlOutput>,
+    /// Requests made since the last `commit`.
+    pending: Vec<WorkspaceRequest>,
+}
+
+/// State for the ext-workspace protocol.
+pub struct ExtWorkspaceManagerState {
+    display: DisplayHandle,
+    instances: Vec<Instance>,
+    /// The desktops last published, in order.
+    workspaces: Vec<WorkspaceInfo>,
+    /// The outputs last published.
+    outputs: Vec<Output>,
+}
+
+impl ExtWorkspaceManagerState {
+    /// Create the state and register the global.
+    pub(crate) fn new<D>(display: &DisplayHandle) -> Self
+    where
+        D: GlobalDispatch<ExtWorkspaceManagerV1, ()>
+            + Dispatch<ExtWorkspaceManagerV1, ()>
+            + 'static,
+    {
+        display.create_global::<D, ExtWorkspaceManagerV1, _>(VERSION, ());
+        Self {
+            display: display.clone(),
+            instances: Vec::new(),
+            workspaces: Vec::new(),
+            outputs: Vec::new(),
+        }
+    }
+
+    /// Publish the desktops, in order, and the outputs their group spans,
+    /// sending each bound manager what changed.
+    ///
+    /// Re-checked on every call even when both lists are unchanged: a client
+    /// that binds an output after the manager gets its `output_enter` here.
+    pub(crate) fn refresh<D>(&mut self, workspaces: Vec<WorkspaceInfo>, outputs: Vec<Output>)
+    where
+        D: Dispatch<ExtWorkspaceHandleV1, WorkspaceData> + 'static,
+    {
+        self.workspaces = workspaces;
+        self.outputs = outputs;
+        for instance in &mut self.instances {
+            instance.sync::<D>(&self.display, &self.workspaces, &self.outputs);
+        }
+    }
+
+    fn instance_mut(&mut self, manager: &ExtWorkspaceManagerV1) -> Option<&mut Instance> {
+        self.instances.iter_mut().find(|i| i.manager == *manager)
+    }
+
+    /// Queue `request` for the commit of `manager`'s client.
+    fn request_queue(&mut self, manager: &ExtWorkspaceManagerV1, request: WorkspaceRequest) {
+        if let Some(instance) = self.instance_mut(manager) {
+            instance.pending.push(request);
+        }
+    }
+}
+
+impl Instance {
+    /// Send what changed since the last sync, then `done` if anything did.
+    fn sync<D>(&mut self, display: &DisplayHandle, workspaces: &[WorkspaceInfo], outputs: &[Output])
+    where
+        D: Dispatch<ExtWorkspaceHandleV1, WorkspaceData> + 'static,
+    {
+        let Some(client) = self.manager.client() else {
+            return;
+        };
+        let mut changed = false;
+
+        // Outputs: the client's own `wl_output`s for every published output.
+        let current: Vec<WlOutput> = outputs
+            .iter()
+            .flat_map(|output| output.client_outputs(&client))
+            .collect();
+        self.outputs.retain(|wl_output| {
+            if current.contains(wl_output) {
+                return true;
+            }
+            if wl_output.is_alive() {
+                self.group.output_leave(wl_output);
+            }
+            changed = true;
+            false
+        });
+        for wl_output in current {
+            if !self.outputs.contains(&wl_output) {
+                self.group.output_enter(&wl_output);
+                self.outputs.push(wl_output);
+                changed = true;
+            }
+        }
+
+        // Removed workspaces leave the group before they go.
+        self.workspaces.retain(|(handle, info, _)| {
+            if workspaces.iter().any(|w| w.id == info.id) {
+                return true;
+            }
+            self.group.workspace_leave(handle);
+            handle.removed();
+            changed = true;
+            false
+        });
+
+        for (index, info) in workspaces.iter().enumerate() {
+            if let Some((handle, sent, sent_index)) = self
+                .workspaces
+                .iter_mut()
+                .find(|(_, sent, _)| sent.id == info.id)
+            {
+                if sent.name != info.name {
+                    handle.name(info.name.clone());
+                    changed = true;
+                }
+                if sent.state() != info.state() {
+                    handle.state(info.state());
+                    changed = true;
+                }
+                if *sent_index != index {
+                    handle.coordinates(coordinates(index));
+                    *sent_index = index;
+                    changed = true;
+                }
+                *sent = info.clone();
+                continue;
+            }
+            let data = WorkspaceData {
+                id: info.id,
+                manager: self.manager.clone(),
+            };
+            let handle = match client.create_resource::<ExtWorkspaceHandleV1, _, D>(
+                display,
+                self.manager.version(),
+                data,
+            ) {
+                Ok(handle) => handle,
+                Err(err) => {
+                    warn!("ext-workspace: creating a workspace handle failed: {err}");
+                    continue;
+                }
+            };
+            self.manager.workspace(&handle);
+            handle.name(info.name.clone());
+            handle.coordinates(coordinates(index));
+            handle.state(info.state());
+            handle.capabilities(WorkspaceCapabilities::Activate | WorkspaceCapabilities::Remove);
+            self.group.workspace_enter(&handle);
+            self.workspaces.push((handle, info.clone(), index));
+            changed = true;
+        }
+
+        if changed {
+            self.manager.done();
+        }
+    }
+}
+
+/// The protocol's coordinates array for a workspace at `index`: one
+/// dimension, native-endian `u32`.
+fn coordinates(index: usize) -> Vec<u8> {
+    u32::try_from(index)
+        .unwrap_or(u32::MAX)
+        .to_ne_bytes()
+        .to_vec()
+}
+
+impl<D> GlobalDispatch<ExtWorkspaceManagerV1, (), D> for ExtWorkspaceManagerState
+where
+    D: GlobalDispatch<ExtWorkspaceManagerV1, ()>
+        + Dispatch<ExtWorkspaceManagerV1, ()>
+        + Dispatch<ExtWorkspaceGroupHandleV1, WorkspaceGroupData>
+        + Dispatch<ExtWorkspaceHandleV1, WorkspaceData>
+        + ExtWorkspaceHandler
+        + 'static,
+{
+    fn bind(
+        state: &mut D,
+        handle: &DisplayHandle,
+        client: &Client,
+        resource: New<ExtWorkspaceManagerV1>,
+        _global_data: &(),
+        data_init: &mut DataInit<'_, D>,
+    ) {
+        let manager = data_init.init(resource, ());
+        let group = match client.create_resource::<ExtWorkspaceGroupHandleV1, _, D>(
+            handle,
+            manager.version(),
+            WorkspaceGroupData {
+                manager: manager.clone(),
+            },
+        ) {
+            Ok(group) => group,
+            Err(err) => {
+                warn!("ext-workspace: creating the workspace group failed: {err}");
+                return;
+            }
+        };
+        manager.workspace_group(&group);
+        group.capabilities(GroupCapabilities::CreateWorkspace);
+
+        let mut instance = Instance {
+            manager,
+            group,
+            workspaces: Vec::new(),
+            outputs: Vec::new(),
+            pending: Vec::new(),
+        };
+        let ws_state = state.ext_workspace_state();
+        instance.sync::<D>(handle, &ws_state.workspaces, &ws_state.outputs);
+        // The group was announced whether or not there was anything in it.
+        if instance.workspaces.is_empty() && instance.outputs.is_empty() {
+            instance.manager.done();
+        }
+        ws_state.instances.push(instance);
+    }
+}
+
+impl<D> Dispatch<ExtWorkspaceManagerV1, (), D> for ExtWorkspaceManagerState
+where
+    D: Dispatch<ExtWorkspaceManagerV1, ()> + ExtWorkspaceHandler,
+{
+    fn request(
+        state: &mut D,
+        _client: &Client,
+        resource: &ExtWorkspaceManagerV1,
+        request: <ExtWorkspaceManagerV1 as Resource>::Request,
+        _data: &(),
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, D>,
+    ) {
+        match request {
+            ext_workspace_manager_v1::Request::Commit => {
+                let requests = state
+                    .ext_workspace_state()
+                    .instance_mut(resource)
+                    .map(|instance| std::mem::take(&mut instance.pending))
+                    .unwrap_or_default();
+                if !requests.is_empty() {
+                    state.ext_workspace_commit(requests);
+                }
+            }
+            ext_workspace_manager_v1::Request::Stop => {
+                // The handles already sent stay with the client, which
+                // destroys them; nothing more is sent to them.
+                state
+                    .ext_workspace_state()
+                    .instances
+                    .retain(|i| i.manager != *resource);
+                resource.finished();
+            }
+            _ => unreachable!("unhandled ext_workspace_manager_v1 request"),
+        }
+    }
+
+    fn destroyed(state: &mut D, _client: ClientId, resource: &ExtWorkspaceManagerV1, _data: &()) {
+        state
+            .ext_workspace_state()
+            .instances
+            .retain(|i| i.manager != *resource);
+    }
+}
+
+impl<D> Dispatch<ExtWorkspaceGroupHandleV1, WorkspaceGroupData, D> for ExtWorkspaceManagerState
+where
+    D: Dispatch<ExtWorkspaceGroupHandleV1, WorkspaceGroupData> + ExtWorkspaceHandler,
+{
+    fn request(
+        state: &mut D,
+        _client: &Client,
+        _resource: &ExtWorkspaceGroupHandleV1,
+        request: <ExtWorkspaceGroupHandleV1 as Resource>::Request,
+        data: &WorkspaceGroupData,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, D>,
+    ) {
+        match request {
+            ext_workspace_group_handle_v1::Request::CreateWorkspace { workspace } => {
+                state
+                    .ext_workspace_state()
+                    .request_queue(&data.manager, WorkspaceRequest::Create(workspace));
+            }
+            // The group is never removed while its manager is bound, so
+            // there is nothing to stop sending to it.
+            ext_workspace_group_handle_v1::Request::Destroy => {}
+            _ => unreachable!("unhandled ext_workspace_group_handle_v1 request"),
+        }
+    }
+}
+
+impl<D> Dispatch<ExtWorkspaceHandleV1, WorkspaceData, D> for ExtWorkspaceManagerState
+where
+    D: Dispatch<ExtWorkspaceHandleV1, WorkspaceData> + ExtWorkspaceHandler,
+{
+    fn request(
+        state: &mut D,
+        _client: &Client,
+        _resource: &ExtWorkspaceHandleV1,
+        request: <ExtWorkspaceHandleV1 as Resource>::Request,
+        data: &WorkspaceData,
+        _dhandle: &DisplayHandle,
+        _data_init: &mut DataInit<'_, D>,
+    ) {
+        let request = match request {
+            ext_workspace_handle_v1::Request::Activate => WorkspaceRequest::Activate(data.id),
+            ext_workspace_handle_v1::Request::Remove => WorkspaceRequest::Remove(data.id),
+            // Not advertised (see the module doc), so ignored as the protocol
+            // allows. A destroyed handle is only ever sent to again when its
+            // workspace goes, and sends to a dead resource are dropped.
+            ext_workspace_handle_v1::Request::Deactivate
+            | ext_workspace_handle_v1::Request::Assign { .. }
+            | ext_workspace_handle_v1::Request::Destroy => return,
+            _ => unreachable!("unhandled ext_workspace_handle_v1 request"),
+        };
+        state
+            .ext_workspace_state()
+            .request_queue(&data.manager, request);
+    }
+}
+
+/// Delegate macro for ext-workspace.
+#[macro_export]
+macro_rules! delegate_ext_workspace {
+    ($ty:ty) => {
+        smithay::reexports::wayland_server::delegate_global_dispatch!($ty: [
+            smithay::reexports::wayland_protocols::ext::workspace::v1::server::ext_workspace_manager_v1::ExtWorkspaceManagerV1: ()
+        ] => $crate::protocols::ext_workspace::ExtWorkspaceManagerState);
+        smithay::reexports::wayland_server::delegate_dispatch!($ty: [
+            smithay::reexports::wayland_protocols::ext::workspace::v1::server::ext_workspace_manager_v1::ExtWorkspaceManagerV1: ()
+        ] => $crate::protocols::ext_workspace::ExtWorkspaceManagerState);
+        smithay::reexports::wayland_server::delegate_dispatch!($ty: [
+            smithay::reexports::wayland_protocols::ext::workspace::v1::server::ext_workspace_group_handle_v1::ExtWorkspaceGroupHandleV1: $crate::protocols::ext_workspace::WorkspaceGroupData
+        ] => $crate::protocols::ext_workspace::ExtWorkspaceManagerState);
+        smithay::reexports::wayland_server::delegate_dispatch!($ty: [
+            smithay::reexports::wayland_protocols::ext::workspace::v1::server::ext_workspace_handle_v1::ExtWorkspaceHandleV1: $crate::protocols::ext_workspace::WorkspaceData
+        ] => $crate::protocols::ext_workspace::ExtWorkspaceManagerState);
+    };
+}
