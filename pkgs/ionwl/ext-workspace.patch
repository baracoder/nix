+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Desktop operations for handler code, each followed by `operator_post`.
+
+use tracing::debug;
+
+use crate::state::IonMain;
+use crate::tiling::DesktopId;
+
+impl IonMain {
+    /// Switch to the desktop `desktop_id`, if it still exists.
+    pub(crate) fn desktop_activate(&mut self, desktop_id: DesktopId) {
+        self.wm_op(|wm, app, registry| {
+            let index = wm.scene.read().layout.desktop_by_id(desktop_id);
+            if let Some(index) = index {
+                wm.desktop_switch_to(app, registry, index);
+            }
+        });
+    }
+
+    /// Create a desktop named `name` (made unique, numbered when empty).
+    pub(crate) fn desktop_create(&mut self, name: &str) {
+        self.wm_op(|wm, app, registry| {
+            wm.desktop_new(app, registry, name);
+        });
+    }
+
+    /// Remove the desktop `desktop_id`, unless the layout refuses: the last
+    /// desktop and one holding windows stay.
+    pub(crate) fn desktop_remove_checked(&mut self, desktop_id: DesktopId) {
+        self.wm_op(|wm, app, registry| {
+            if let Err(refused) = wm.desktop_remove(app, registry, desktop_id) {
+                debug!("Desktop {desktop_id:?} not removed: {refused:?}");
+            }
+        });
+    }
+}
