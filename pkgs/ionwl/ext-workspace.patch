+impl Dispatch<ExtWorkspaceManagerV1, ()> for ClientState {
+    fn event(
+        state: &mut Self,
+        _proxy: &ExtWorkspaceManagerV1,
+        event: <ExtWorkspaceManagerV1 as wayland_client::Proxy>::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qhandle: &QueueHandle<Self>,
+    ) {
+        let view = &mut state.ext_workspace;
+        match event {
+            ext_workspace_manager_v1::Event::WorkspaceGroup { workspace_group } => {
+                view.groups.push(workspace_group);
+            }
+            ext_workspace_manager_v1::Event::Workspace { workspace } => {
+                view.pending.push((workspace, WorkspaceEntry::default()));
+            }
+            ext_workspace_manager_v1::Event::Done => {
+                view.done = view.pending.clone();
+                view.done_count += 1;
+            }
+            _ => (),
+        }
+    }
+
+    wayland_client::event_created_child!(ClientState, ExtWorkspaceManagerV1, [
+        ext_workspace_manager_v1::EVT_WORKSPACE_GROUP_OPCODE => (ExtWorkspaceGroupHandleV1, ()),
+        ext_workspace_manager_v1::EVT_WORKSPACE_OPCODE => (ExtWorkspaceHandleV1, ()),
+    ]);
+}
+
+impl Dispatch<ExtWorkspaceGroupHandleV1, ()> for ClientState {
+    fn event(
+        state: &mut Self,
+        _proxy: &ExtWorkspaceGroupHandleV1,
+        event: <ExtWorkspaceGroupHandleV1 as wayland_client::Proxy>::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qhandle: &QueueHandle<Self>,
+    ) {
+        let view = &mut state.ext_workspace;
+        match event {
+            ext_workspace_group_handle_v1::Event::OutputEnter { output } => {
+                view.group_outputs.push(output);
+            }
+            ext_workspace_group_handle_v1::Event::OutputLeave { output } => {
+                view.group_outputs.retain(|bound| *bound != output);
+            }
+            ext_workspace_group_handle_v1::Event::WorkspaceEnter { workspace } => {
+                view.in_group_set(&workspace, true);
+            }
+            ext_workspace_group_handle_v1::Event::WorkspaceLeave { workspace } => {
+                view.in_group_set(&workspace, false);
+            }
+            _ => (),
+        }
+    }
+}
+
+impl Dispatch<ExtWorkspaceHandleV1, ()> for ClientState {
+    fn event(
+        state: &mut Self,
+        proxy: &ExtWorkspaceHandleV1,
+        event: <ExtWorkspaceHandleV1 as wayland_client::Proxy>::Event,
+        _data: &(),
+        _conn: &Connection,
+        _qhandle: &QueueHandle<Self>,
+    ) {
+        let view = &mut state.ext_workspace;
+        if matches!(event, ext_workspace_handle_v1::Event::Removed) {
+            assert!(
+                view.pending
+                    .iter()
+                    .any(|(handle, entry)| handle == proxy && !entry.in_group),
+                "a workspace is removed only after leaving its group"
+            );
+            view.pending.retain(|(handle, _)| handle != proxy);
+            proxy.destroy();
+            return;
+        }
+        let Some((_, entry)) = view.pending.iter_mut().find(|(handle, _)| handle == proxy) else {
+            return;
+        };
+        match event {
+            ext_workspace_handle_v1::Event::Name { name } => entry.name = name,
+            ext_workspace_handle_v1::Event::Coordinates { coordinates } => {
+                entry.coordinate = coordinates
+                    .as_chunks::<4>()
+                    .0
+                    .first()
+                    .map(|chunk| u32::from_ne_bytes(*chunk));
+            }
+            ext_workspace_handle_v1::Event::State {
+                state: WEnum::Value(flags),
+            } => {
+                entry.active = flags.contains(ext_workspace_handle_v1::State::Active);
+                entry.urgent = flags.contains(ext_workspace_handle_v1::State::Urgent);
+            }
+            _ => (),
+        }
+    }
+}
