diff --git a/tests/integration/api/ext_workspace.rs b/tests/integration/api/ext_workspace.rs
new file mode 100644
index 00000000..a79cfcba
--- /dev/null
+++ b/tests/integration/api/ext_workspace.rs
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! ext-workspace tests: the desktops as a bar's workspace switcher sees them,
+//! and the requests it makes.
+
+use crate::common::{ClientId, Fixture, WorkspaceEntry};
+
+use super::helpers::{desktop_active_name, desktop_add, desktop_focus};
+
+/// One output, the default desktop plus `names` after it, and a client bound
+/// to ext-workspace that has seen them.
+fn workspace_fixture(names: &[&str]) -> (Fixture, ClientId) {
+    let mut fixture = Fixture::new();
+    fixture.output_add_default();
+    for name in names {
+        desktop_add(&mut fixture, name);
+    }
+    let client_id = fixture.add_client();
+    fixture.double_roundtrip(client_id);
+    (fixture, client_id)
+}
+
+/// The workspaces the client last saw `done` for, after a roundtrip.
+fn workspaces(fixture: &mut Fixture, client_id: ClientId) -> Vec<WorkspaceEntry> {
+    fixture.double_roundtrip(client_id);
+    fixture.client(client_id).ext_workspaces()
+}
+
+/// The names of `workspaces` in order, and the one active.
+fn names_active(workspaces: &[WorkspaceEntry]) -> (Vec<&str>, Vec<&str>) {
+    (
+        workspaces.iter().map(|w| w.name.as_str()).collect(),
+        workspaces
+            .iter()
+            .filter(|w| w.active)
+            .map(|w| w.name.as_str())
+            .collect(),
+    )
+}
+
+/// Every desktop is a workspace in the one group, in desktop order with its
+/// index as its coordinate, and the active desktop is the one active.
+#[test]
+fn desktops_listed_in_one_group() {
+    let (mut fixture, client_id) = workspace_fixture(&["b", "c"]);
+    let first = desktop_active_name(&mut fixture);
+    let listed = workspaces(&mut fixture, client_id);
+
+    let (names, active) = names_active(&listed);
+    assert_eq!(names, [first.as_str(), "b", "c"]);
+    assert_eq!(active, [first.as_str()]);
+    assert!(listed.iter().all(|w| w.in_group), "{listed:?}");
+    assert_eq!(
+        listed.iter().map(|w| w.coordinate).collect::<Vec<_>>(),
+        [Some(0), Some(1), Some(2)],
+    );
+    assert_eq!(
+        fixture
+            .client(client_id)
+            .ext_workspace_group_outputs()
+            .len(),
+        1
+    );
+}
+
+/// The group spans every output, as each desktop does.
+#[test]
+fn group_enters_every_output() {
+    let (mut fixture, client_id) = workspace_fixture(&[]);
+    fixture.output_add_default_right();
+    fixture.double_roundtrip(client_id);
+    fixture.double_roundtrip(client_id);
+    assert_eq!(
+        fixture
+            .client(client_id)
+            .ext_workspace_group_outputs()
+            .len(),
+        2
+    );
+}
+
+/// Switching desktops moves the active state, in one `done`.
+#[test]
+fn switch_moves_active() {
+    let (mut fixture, client_id) = workspace_fixture(&["b"]);
+    let done_before = fixture.client(client_id).ext_workspace_done_count();
+    desktop_focus(&mut fixture, 1);
+    let listed = workspaces(&mut fixture, client_id);
+
+    assert_eq!(names_active(&listed).1, ["b"]);
+    assert_eq!(
+        fixture.client(client_id).ext_workspace_done_count(),
+        done_before + 1,
+    );
+}
+
+/// With nothing changed, nothing is sent.
+#[test]
+fn unchanged_sends_nothing() {
+    let (mut fixture, client_id) = workspace_fixture(&["b"]);
+    let done_before = fixture.client(client_id).ext_workspace_done_count();
+    fixture.double_roundtrip(client_id);
+    assert_eq!(
+        fixture.client(client_id).ext_workspace_done_count(),
+        done_before,
+    );
+}
+
+/// Activating a workspace switches to its desktop.
+#[test]
+fn activate_switches_desktop() {
+    let (mut fixture, client_id) = workspace_fixture(&["b"]);
+    fixture.client(client_id).ext_workspace_activate("b");
+    let listed = workspaces(&mut fixture, client_id);
+
+    assert_eq!(desktop_active_name(&mut fixture), "b");
+    assert_eq!(names_active(&listed).1, ["b"]);
+}
+
+/// Creating a workspace in the group adds a desktop after the others.
+#[test]
+fn create_adds_desktop() {
+    let (mut fixture, client_id) = workspace_fixture(&[]);
+    fixture.client(client_id).ext_workspace_create("new");
+    let listed = workspaces(&mut fixture, client_id);
+
+    assert_eq!(names_active(&listed).0.last(), Some(&"new"));
+}
+
+/// Removing an empty, inactive workspace removes its desktop, and the client
+/// sees it leave the group before it goes.
+#[test]
+fn remove_drops_desktop() {
+    let (mut fixture, client_id) = workspace_fixture(&["b", "c"]);
+    fixture.client(client_id).ext_workspace_remove("b");
+    let listed = workspaces(&mut fixture, client_id);
+
+    let first = desktop_active_name(&mut fixture);
+    assert_eq!(names_active(&listed).0, [first.as_str(), "c"]);
+    assert_eq!(listed[1].coordinate, Some(1), "the coordinates close up");
+}
+
+/// The last desktop cannot be removed, as from Python.
+#[test]
+fn remove_last_refused() {
+    let (mut fixture, client_id) = workspace_fixture(&[]);
+    let first = desktop_active_name(&mut fixture);
+    fixture.client(client_id).ext_workspace_remove(&first);
+    let listed = workspaces(&mut fixture, client_id);
+
+    assert_eq!(names_active(&listed).0, [first.as_str()]);
+}
+
+/// A desktop holding an urgent window is reported urgent.
+#[test]
+fn urgent_window_marks_its_desktop() {
+    let (mut fixture, client_id) = workspace_fixture(&["b"]);
+    let window_client = fixture.add_client();
+    fixture.spawn_window(window_client);
+    fixture.deferred_process();
+    let window_id = super::helpers::first_window(&mut fixture);
+    desktop_focus(&mut fixture, 1);
+    fixture.ionwl().window_urgent_set(window_id, true);
+    let listed = workspaces(&mut fixture, client_id);
+
+    assert_eq!(
+        listed.iter().map(|w| w.urgent).collect::<Vec<_>>(),
+        [true, false],
+    );
+}
