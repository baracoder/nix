 src/handler/input/pointer.rs          | 18 +++---
 src/handler/input/pointer_hit_test.rs |  7 ++-
 src/state/layer.rs                    |  9 ++-
 tests/integration/api/layer_shell.rs  | 79 +++++++++++++++++++++++++++
 5 files changed, 118 insertions(+), 15 deletions(-)

