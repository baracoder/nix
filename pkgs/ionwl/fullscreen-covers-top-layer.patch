--- a/src/backend/helpers.rs
+++ b/src/backend/helpers.rs
@@ -201,6 +201,17 @@ fn layer_loc_centered_for_anchor(
 /// foreground pass draws them.
 pub const LAYERS_FOREGROUND: [Layer; 2] = [Layer::Overlay, Layer::Top];
 
+/// The foreground z-bands an output shows, topmost first. A fullscreen
+/// window covers the Top band - panels and bars - leaving only Overlay above
+/// it, as layer-shell intends: Overlay is for what must show over fullscreen.
+pub fn layers_foreground(fullscreen_covers: bool) -> &'static [Layer] {
+    if fullscreen_covers {
+        &LAYERS_FOREGROUND[..1]
+    } else {
+        &LAYERS_FOREGROUND
+    }
+}
