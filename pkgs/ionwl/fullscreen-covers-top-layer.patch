+
+/// A fullscreen window covers the `Top` band - a bar - and leaves `Overlay`
+/// above it: the bar neither draws nor takes the pointer until the window
+/// leaves fullscreen.
+#[test]
+fn fullscreen_covers_top_layer() {
+    let mut fixture = Fixture::new();
+    let output_id = fixture.output_add_default();
+    let client_id = fixture.add_client();
+    let spawn = |fixture: &mut Fixture, layer, width: i32| {
+        fixture.spawn_layer_surface(
+            client_id,
+            layer,
+            &LayerConfigureProps {
+                size: Some((width as u32, 200)),
+                anchor: Some(LayerAnchor::Top | LayerAnchor::Left | LayerAnchor::Right),
+                keyboard_interactivity: Some(KeyboardInteractivity::None),
+                ..Default::default()
+            },
+        )
+    };
+    let top_width = 401;
+    let overlay_width = 101;
+    let _top = spawn(&mut fixture, Layer::Top, top_width);
+    let _overlay = spawn(&mut fixture, Layer::Overlay, overlay_width);
+    let surface = fixture.spawn_window(client_id);
+    fixture.dispatch();
+
+    let centered = |width: i32| [(DEFAULT_OUTPUT_W - width) / 2, 0];
+    // Inside the Top surface, outside the Overlay one.
+    let bar_spot = [(DEFAULT_OUTPUT_W - top_width) / 2 + 1, 100];
+    let bands = |fixture: &mut Fixture| {
+        fixture.core().wm.render_inputs_sync_test();
+        fixture.core().wm.layer_bands_test(output_id)
+    };
+    assert_eq!(
+        bands(&mut fixture),
+        Some([
+            vec![centered(overlay_width), centered(top_width)],
+            Vec::new()
+        ]),
+        "precondition: both bands draw over a tiled window"
+    );
+
+    fixture.window_fullscreen_with_margin(client_id, &surface, 0);
+    assert_eq!(
+        bands(&mut fixture),
+        Some([vec![centered(overlay_width)], Vec::new()]),
+        "the fullscreen window covers the Top band, not Overlay"
+    );
+    let bar = fixture.ionwl().layer_surface_at_point_test(bar_spot);
+    assert!(bar.is_some(), "precondition: the bar is mapped there");
+    assert_ne!(
+        fixture.ionwl().pointer_surface_at_test(bar_spot),
+        bar,
+        "the covered bar takes no pointer"
+    );
+
+    fixture
+        .client(client_id)
+        .window_for_surface(&surface)
+        .unset_fullscreen();
+    fixture.roundtrip(client_id);
+    fixture.dispatch();
+    fixture.roundtrip(client_id);
+    assert_eq!(
+        bands(&mut fixture),
+        Some([
+            vec![centered(overlay_width), centered(top_width)],
+            Vec::new()
+        ]),
+        "leaving fullscreen brings the bar back"
+    );
+    assert_eq!(
+        fixture.ionwl().pointer_surface_at_test(bar_spot),
+        bar,
+        "the bar takes the pointer again"
+    );
+}
